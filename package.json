    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "preview": "node scripts/preview.mjs",
    "build": "tsc && tsc -p tsconfig.web.json && node scripts/build-web.mjs",
    "start": "node dist/main.js",
