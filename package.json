    "nostr-tools": "^2",
    "pg": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/ws": "^8",
    "esbuild": "^0.28",
    "prettier": "^3.9.10",
    "tsx": "^4",
    "typescript": "^6",
    "ws": "^8"
  },
  "packageManager": "pnpm@11.25.0"
