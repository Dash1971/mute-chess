@@ -0,0 +1,43 @@
+import importlib.util
+import io
+from pathlib import Path
+import unittest
+from unittest.mock import patch, MagicMock
+
+from PIL import Image
+
+
+spec = importlib.util.spec_from_file_location("make_sprites", Path(__file__).with_name("make-sprites.py"))
+sprites = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(sprites)
+
+
+class MossSpritesTest(unittest.TestCase):
+    def test_native_moss_colors_survive_official_palette_quantization(self):
+        empty = Image.new("RGBA", (90, 90))
+        pieces = {f"{color}{piece}": empty for color in "wb" for piece in "PNBRQK"}
+        light, dark = sprites.BOARD_THEMES["quiet-signal"]
+        image = sprites.make_sprite(light, dark, pieces, empty, exact_square_colors=True).convert("RGB")
+        self.assertEqual(image.getpixel((0, 0)), (199, 207, 186))
+        self.assertEqual(image.getpixel((90, 0)), (102, 132, 120))
+
+    def test_theme_filter_only_writes_moss_and_keeps_all_piece_sets(self):
+        piece_dirs = [p.name for p in (Path(__file__).parent / "piece").iterdir() if p.is_dir()]
+        self.assertEqual(len(piece_dirs), 40)
+        entries = [MagicMock(path=name, is_dir=lambda: True) for name in piece_dirs]
+        image = MagicMock()
+        with patch.object(sprites.os, "scandir", return_value=entries), \
+                patch.object(sprites, "resvg"), \
+                patch.object(sprites, "resvg_pieces"), \
+                patch.object(sprites, "make_sprite", return_value=image), \
+                patch.object(sprites, "rust_code_updates"), \
+                patch("sys.stdout", new_callable=io.StringIO):
+            sprites.main(["--theme", "quiet-signal"])
+        self.assertEqual(
+            [call.args[0] for call in image.save.call_args_list],
+            [f"sprites/quiet-signal-{name}.gif" for name in sorted(piece_dirs)],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
