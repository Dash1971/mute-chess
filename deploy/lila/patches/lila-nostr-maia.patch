new file mode 100644
index 0000000..a619492
--- /dev/null
+++ b/ui/analyse/src/noSweatOpening.ts
@@ -0,0 +1,130 @@
+import { Chess } from 'chessops/chess';
+import { makeFen, parseFen } from 'chessops/fen';
+
+import { escapeHtml } from 'lib';
+import { domDialog } from 'lib/view';
+
+import type AnalyseCtrl from './ctrl';
+
+export type OpeningEntry = readonly [epd: string, eco: string, name: string];
+let entries: Map<string, string> | undefined;
+let loading: Promise<void> | undefined;
+
+export function openingEpd(fen: string): string | undefined {
+  try {
+    const setup = parseFen(fen).unwrap();
+    // Match Mobile Maia / Lichess EPD normalization, including legal en passant.
+    const pos = Chess.fromSetup(setup).unwrap();
+    return makeFen(pos.toSetup()).split(' ').slice(0, 4).join(' ');
+  } catch {
+    return undefined;
+  }
+}
+
+export function identifyOpening(
+  fens: readonly string[],
+  table: ReadonlyMap<string, string>,
+): string | undefined {
+  for (let i = fens.length - 1; i >= 0; i--) {
+    const epd = openingEpd(fens[i]);
+    const name = epd && table.get(epd);
+    if (name) return name;
+  }
+  return undefined;
+}
+
+function loadOpenings(): Promise<void> {
+  return (loading ??= fetch(site.asset.url('nosweat/openings.json'))
+    .then(response => {
+      if (!response.ok) throw new Error('Opening names unavailable');
+      return response.json();
+    })
+    .then((rows: OpeningEntry[]) => {
+      entries = new Map(rows.map(([epd, eco, name]) => [epd, `${eco} · ${name}`]));
+    }));
+}
+
+export class OpeningLabel {
+  private readonly row = document.createElement('div');
+  private readonly label = document.createElement('button');
+  private readonly observer: ResizeObserver;
+  private name = '';
+  private context = '';
+
+  constructor(
+    private readonly ctrl: AnalyseCtrl,
+    underboard: HTMLElement,
+  ) {
+    this.row.className = 'nosweat-opening';
+    this.label.type = 'button';
+    this.label.className = 'nosweat-opening-name';
+    this.label.hidden = true;
+    this.row.append(this.label);
+    underboard.prepend(this.row);
+    this.label.onclick = () => {
+      if (this.label.scrollWidth <= this.label.clientWidth) return;
+      domDialog({
+        modal: true,
+        show: true,
+        easyClose: 'clickOutside',
+        class: 'nosweat-opening-dialog',
+        htmlText: `<h2>${escapeHtml(i18n.site.opening)}</h2><p>${escapeHtml(this.name)}</p><button class="button">${escapeHtml(i18n.site.close)}</button>`,
+        actions: [{ selector: 'button', listener: (_event, dialog) => dialog.close() }],
+      });
+    };
+    this.observer = new ResizeObserver(() => this.measure());
+    this.observer.observe(this.label);
+    const playerStrip = underboard.closest('.analyse')?.querySelector('.analyse__player_strip.bottom');
+    if (playerStrip) this.observer.observe(playerStrip);
+    void document.fonts?.ready.then(() => this.measure());
+    window.addEventListener('pagehide', () => this.observer.disconnect(), { once: true });
+    void loadOpenings()
+      .then(() => this.redraw())
+      .catch(() => this.redraw());
+    this.redraw();
+  }
+
+  redraw(): void {
+    if (!this.row.isConnected) return;
+    const context = `${this.ctrl.path}:${this.ctrl.node.fen}:${!!entries}`;
+    if (context === this.context) return;
+    this.context = context;
+    const path = this.ctrl.nodeList;
+    const fallback = this.ctrl.data.game.opening;
+    // A final-game opening is a safe fallback only once its own node is on this path.
+    this.name =
+      (entries &&
+        identifyOpening(
+          path.map(n => n.fen),
+          entries,
+        )) ||
+      (fallback &&
+      path.some(
+        n => n.ply === fallback.ply && n.fen === this.ctrl.mainline.find(m => m.ply === fallback.ply)?.fen,
+      )
+        ? `${fallback.eco} · ${fallback.name}`
+        : '');
+    this.label.textContent = this.name;
+    this.label.hidden = !this.name;
+    this.label.title = this.name;
+    this.measure();
+  }
+
+  destroy(): void {
+    this.observer.disconnect();
+    this.row.remove();
+  }
+
+  private measure(): void {
+    // Native material and clocks share this row. Keep the name centered on the
+    // board by reserving the lower player strip's width on both sides.
+    const strip = this.row.closest('.analyse')?.querySelector('.analyse__player_strip.bottom');
+    const width = strip?.getBoundingClientRect().width ?? 0;
+    this.row.style.setProperty('--nosweat-opening-clearance', `${width > 1 ? Math.ceil(width) + 8 : 0}px`);
+    const truncated = this.label.scrollWidth > this.label.clientWidth;
+    this.label.disabled = !truncated;
+    this.label.classList.toggle('truncated', truncated);
+    this.label.setAttribute('aria-label', this.name + (truncated ? '. Show full opening name' : ''));
+    this.label.setAttribute('aria-haspopup', truncated ? 'dialog' : 'false');
+  }
+}
diff --git a/ui/analyse/src/noSweatPgn.ts b/ui/analyse/src/noSweatPgn.ts
new file mode 100644
index 0000000..a908da3
--- /dev/null
+++ b/ui/analyse/src/noSweatPgn.ts
@@ -0,0 +1,85 @@
+import { INITIAL_FEN } from 'chessops/fen';
+import { ChildNode, Node, makeComment, makeOutcome, makePgn, type PgnNodeData } from 'chessops/pgn';
+
+import type { TreeNodeLite } from 'lib/tree/types';
+
+import type AnalyseCtrl from './ctrl';
+import { position } from './noSweatCore';
+
+export type PgnExportMode = 'annotated' | 'raw';
+
+// Use the same Chessops PGN model as native import. Export the actual tree,
+// including annotations and variations, rather than an unsubmitted import draft.
+// Native postgame raw export rebuilds SAN without any comments or NAGs, even
+// imported ones (game/PgnDump.scala; api/PgnDump.scala). Raw follows that mainline
+// behavior; annotated includes all variations. Both use current board headers.
+export function boardPgn(ctrl: AnalyseCtrl, mode: PgnExportMode = 'annotated'): string {
+  const annotated = mode === 'annotated';
+  const root = ctrl.tree.root;
+  let end: TreeNodeLite = root;
+  while (end.children[0]) end = end.children[0];
+  const headers = new Map(
+    ctrl.data.noSweatPgnHeaders ?? [
+      ['Event', 'Analysis'],
+      ['Site', 'https://mutechess.org'],
+      ['Date', '????.??.??'],
+      ['Round', '?'],
+      ['White', '?'],
+      ['Black', '?'],
+      ['Result', makeOutcome(position(end.fen).outcome())],
+    ],
+  );
+  const outcome = position(end.fen).outcome();
+  if (outcome) headers.set('Result', makeOutcome(outcome));
+  if (root.fen !== INITIAL_FEN) {
+    headers.set('SetUp', '1');
+    headers.set('FEN', root.fen);
+  } else {
+    headers.delete('SetUp');
+    headers.delete('FEN');
+  }
+  const moves = new Node<PgnNodeData>();
+  const append = (into: Node<PgnNodeData>, from: TreeNodeLite) => {
+    for (const child of annotated ? from.children : from.children.slice(0, 1)) {
+      if (!child.san) continue;
+      const comments = annotated ? (child.comments?.map(c => c.text) ?? []) : [];
+      const score = annotated ? (child.eval ?? child.ceval) : undefined;
+      const clock =
+        annotated && child.clock !== undefined && Number.isFinite(child.clock) && child.clock >= 0
+          ? child.clock / 100
+          : undefined;
+      if (score?.mate !== undefined || score?.cp !== undefined || clock !== undefined)
+        comments.push(
+          makeComment({
+            evaluation:
+              score?.mate !== undefined
+                ? { mate: score.mate, depth: score.depth }
+                : score?.cp !== undefined
+                  ? { pawns: score.cp / 100, depth: score.depth }
+                  : undefined,
+            clock,
+          }),
+        );
+      const node = new ChildNode<PgnNodeData>({
+        san: child.san,
+        nags: annotated ? [...new Set(child.glyphs?.map(g => g.id))] : undefined,
+        comments,
+      });
+      into.children.push(node);
+      append(node, child);
+    }
+  };
+  append(moves, root);
+  return makePgn({ headers, moves, comments: annotated ? root.comments?.map(c => c.text) : undefined });
+}
+
+export function downloadBoardPgn(ctrl: AnalyseCtrl, mode: PgnExportMode = 'annotated'): void {
+  const url = URL.createObjectURL(
+    new Blob([boardPgn(ctrl, mode)], { type: 'application/x-chess-pgn;charset=utf-8' }),
+  );
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = mode === 'raw' ? 'mutechess-analysis-raw.pgn' : 'mutechess-analysis.pgn';
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
