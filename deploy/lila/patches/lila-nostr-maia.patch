index 0000000..45ec2e2
--- /dev/null
+++ b/modules/bot/src/main/ManagedPresence.scala
@@ -0,0 +1,26 @@
+package lila.bot
+
+/** One expiring health lease for a managed roster, not one timer per account. */
+private[bot] final class ManagedPresence(
+    ttlMillis: Long,
+    now: () => Long,
+    publish: Set[UserId] => Unit
+):
+  private var ids = Set.empty[UserId]
+  private var online = false
+  private var until = 0L
+
+  def heartbeat(next: Set[UserId]): Unit = synchronized:
+    until = now() + ttlMillis
+    val changed = !online || ids != next
+    ids = next
+    online = true
+    if changed then publish(ids)
+
+  def expire(): Unit = synchronized:
+    if online && now() >= until then
+      online = false
+      publish(Set.empty)
+
+  def activeIds: Set[UserId] = synchronized:
+    if online then ids else Set.empty
diff --git a/modules/bot/src/main/PoolCatalog.scala b/modules/bot/src/main/PoolCatalog.scala
new file mode 100644
index 0000000..902252a
--- /dev/null
+++ b/modules/bot/src/main/PoolCatalog.scala
@@ -0,0 +1,40 @@
+package lila.bot
+
+import scala.collection.immutable.TreeMap
+import lila.core.perf.PerfKey
+
+/** Derived index only. Native perfs remain authoritative and are checked at admission. */
+final class PoolCatalog:
+  private var ratings = Map.empty[UserId, Map[PerfKey, Int]]
+  private var pools = Map.empty[PerfKey, TreeMap[Int, Set[UserId]]]
+
+  def replace(entries: Map[UserId, Map[PerfKey, Int]]): Unit = synchronized:
+    ratings = Map.empty
+    pools = Map.empty
+    entries.foreach((id, perfs) => update(id, perfs))
+
+  def update(id: UserId, perfs: Map[PerfKey, Int]): Unit = synchronized:
+    ratings
+      .get(id)
+      .foreach(_.foreach: (key, rating) =>
+        val pool = pools(key)
+        val ids = pool(rating) - id
+        pools = pools.updated(key, if ids.isEmpty then pool.removed(rating) else pool.updated(rating, ids)))
+    if perfs.isEmpty then ratings = ratings.removed(id)
+    else
+      ratings = ratings.updated(id, perfs)
+      perfs.foreach: (key, rating) =>
+        val pool = pools.getOrElse(key, TreeMap.empty[Int, Set[UserId]])
+        pools = pools.updated(key, pool.updated(rating, pool.getOrElse(rating, Set.empty) + id))
+
+  def within(key: PerfKey, rating: Int, excluded: Set[UserId]): Vector[UserId] = synchronized:
+    pools
+      .get(key)
+      .fold(Vector.empty[UserId]): pool =>
+        pool
+          .rangeFrom(rating - 200)
+          .rangeTo(rating + 200)
+          .valuesIterator
+          .flatMap(_.iterator)
+          .filterNot(excluded)
+          .toVector
