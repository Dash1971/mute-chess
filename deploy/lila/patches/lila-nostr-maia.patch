diff --git a/src/test/scala/NoSweatBotCatalogTest.scala b/src/test/scala/NoSweatBotCatalogTest.scala
new file mode 100644
index 0000000..3772eee
--- /dev/null
+++ b/src/test/scala/NoSweatBotCatalogTest.scala
@@ -0,0 +1,95 @@
+package lila.app
+
+import play.api.libs.json.*
+import lila.core.perf.PerfKey
+
+class NoSweatBotCatalogTest extends munit.FunSuite:
+  private val legacy = Json.obj(
+    "id" -> "legacy",
+    "username" -> "SignalTrain001",
+    "ratings" -> Json.obj(
+      "blitz" -> Json.obj("initial_rating" -> 1500, "initial_rd" -> 200),
+      "rapid" -> Json.obj("initial_rating" -> 1550, "initial_rd" -> 300)
+    )
+  )
+  private val catalog = Json.obj(
+    "id" -> "catalog-one",
+    "username" -> "CatalogOne",
+    "name" -> "Catalog One",
+    "rating_assignment" -> Json.obj("schema" -> 1, "method" -> "research", "gameCount" -> 0),
+    "ratings" -> JsObject(NoSweatBotCatalog.speeds.zipWithIndex.map: (speed, i) =>
+      speed.value -> Json.obj("initial_rating" -> (1600 + i * 25), "initial_rd" -> 100))
+  )
+
+  test("the entire roster rejects duplicate IDs and case-insensitive usernames before initialization"):
+    assertEquals(NoSweatBotCatalog.validate(List(legacy, catalog)), List(legacy, catalog))
+    assertEquals(NoSweatBotCatalog.publicName(catalog, Map.empty), Some("Catalog One"))
+    intercept[IllegalArgumentException]:
+      NoSweatBotCatalog.validate(List(legacy, legacy ++ Json.obj("username" -> "OtherName")))
+    intercept[IllegalArgumentException]:
+      NoSweatBotCatalog.validate(
+        List(legacy, legacy ++ Json.obj("id" -> "other", "username" -> "signaltrain001"))
+      )
+
+  test("assigned priors preserve zero games and use native nonprovisional Glicko"):
+    NoSweatBotCatalog.speeds.zipWithIndex.foreach: (speed, i) =>
+      val perf = NoSweatBotCatalog.seededPerf(catalog, speed)
+      assertEquals(perf.nb, 0)
+      assertEquals(perf.recent, Nil)
+      assert(perf.latest.isDefined)
+      assert(perf.nonEmpty)
+      assertEquals(perf.intRating.value, 1600 + i * 25)
+      assertEquals(perf.glicko.deviation, 100d)
+      assert(perf.provisional.no)
+      val player = lila.game.Player.make(chess.White, UserId("catalogone") -> perf)
+      assertEquals(player.rating.map(_.value), Some(1600 + i * 25))
+      assert(player.provisional.no)
+
+  test("legacy speed fallbacks remain unchanged while explicit catalog speed priors are retained"):
+    assertEquals(NoSweatBotCatalog.seededPerf(legacy, PerfKey.bullet).intRating.value, 1500)
+    assertEquals(NoSweatBotCatalog.seededPerf(legacy, PerfKey.classical).intRating.value, 1550)
+    assertEquals(NoSweatBotCatalog.seededPerf(legacy, PerfKey.bullet).glicko.deviation, 200d)
+    assertEquals(NoSweatBotCatalog.seededPerf(legacy, PerfKey.classical).glicko.deviation, 300d)
+    assertEquals(NoSweatBotCatalog.seededPerf(catalog, PerfKey.bullet).intRating.value, 1625)
+
+  test("a catalog entry cannot adopt another existing account even if the account was a managed bot"):
+    assertEquals(NoSweatBotCatalog.initialIdentity(legacy), None)
+    assertEquals(NoSweatBotCatalog.initialIdentity(catalog), Some("catalog-one"))
+    assert(NoSweatBotCatalog.reusable(catalog, false, None))
+    // A restart after creation, before perf seeding, sees the insert's identity marker.
+    assert(NoSweatBotCatalog.reusable(catalog, true, NoSweatBotCatalog.initialIdentity(catalog)))
+    assert(NoSweatBotCatalog.reusable(catalog, true, Some("catalog-one")))
+    assert(!NoSweatBotCatalog.reusable(catalog, true, None))
+    assert(!NoSweatBotCatalog.reusable(catalog, true, Some("different")))
+    assert(NoSweatBotCatalog.reusable(legacy, true, None))
+
+  test("catalog priors require all six explicit speeds and the reviewed initial deviation"):
+    intercept[IllegalArgumentException]:
+      NoSweatBotCatalog.validate(
+        List(
+          legacy ++ Json.obj(
+            "name" -> "Legacy",
+            "rating_assignment" -> Json.obj("schema" -> 1, "gameCount" -> 0)
+          )
+        )
+      )
+    val wrong = catalog ++ Json.obj(
+      "ratings" -> (catalog \ "ratings")
+        .as[JsObject]
+        .deepMerge(Json.obj("blitz" -> Json.obj("initial_rd" -> 300)))
+    )
+    intercept[IllegalArgumentException](NoSweatBotCatalog.validate(List(wrong)))
+
+  test("public aliases are restricted to managed placeholder names and cannot overwrite a chosen name"):
+    assertEquals(
+      NoSweatBotCatalog.aliases(Map("SignalTrain001" -> "Roy Batty"), List(legacy)),
+      Map("signaltrain001" -> "Roy Batty")
+    )
+    intercept[IllegalArgumentException]:
+      NoSweatBotCatalog.aliases(Map("CatalogOne" -> "Roy Batty"), List(catalog))
+    intercept[IllegalArgumentException]:
+      NoSweatBotCatalog.aliases(Map("SignalTrain001" -> "x" * 21), List(legacy))
+    assert(NoSweatBotCatalog.aliasEligible(None, "SignalTrain001", "Roy Batty"))
+    assert(NoSweatBotCatalog.aliasEligible(Some("SignalTrain001"), "SignalTrain001", "Roy Batty"))
+    assert(NoSweatBotCatalog.aliasEligible(Some("Roy Batty"), "SignalTrain001", "Roy Batty"))
+    assert(!NoSweatBotCatalog.aliasEligible(Some("ChosenName"), "SignalTrain001", "Roy Batty"))
diff --git a/src/test/scala/NoSweatStudyPlanTest.scala b/src/test/scala/NoSweatStudyPlanTest.scala
new file mode 100644
index 0000000..806bb5f
--- /dev/null
+++ b/src/test/scala/NoSweatStudyPlanTest.scala
@@ -0,0 +1,89 @@
+package lila.app
+
+class NoSweatStudyPlanTest extends munit.FunSuite:
+  test("the original pilot ramp and one-worker plan remain unchanged"):
+    val plan = NoSweatStudyPlan.find("pilot-10-v1").get
+    assertEquals(plan.workers, 1)
+    assertEquals(plan.maximumAdmitted, 100)
+    assertEquals(plan.maximumConcurrency, 10)
+    assertEquals(List(0, 4, 5, 9, 10, 19, 20, 100).map(plan.capacity), List(1, 1, 2, 2, 5, 5, 10, 10))
+
+  test("the expanded trial has explicit steps, two workers and a hard 22-game ceiling"):
+    val plan = NoSweatStudyPlan.find("ramp-22-v1").get
+    assertEquals(plan.workers, 2)
+    assertEquals(plan.maximumAdmitted, 100)
+    assertEquals(plan.maximumConcurrency, 22)
+    assertEquals(List(0, 9, 10, 24, 25, 39, 40, 100).map(plan.capacity), List(10, 10, 15, 15, 20, 20, 22, 22))
+    assertEquals(NoSweatStudyPlan.find("unbounded"), None)
+    intercept[IllegalArgumentException](plan.capacity(-1))
+
+  test("the calibration batch permits exactly the reviewed 200-admission budget"):
+    val plan = NoSweatStudyPlan.find("calibration-200-v1").get
+    assertEquals(plan.maximumAdmitted, 200)
+    assertEquals(plan.maximumConcurrency, 22)
+    assertEquals(plan.workers, 2)
+    assertEquals(List(0, 1, 99, 100, 199, 200).map(plan.capacity), List.fill(6)(22))
+
+  test("the dated validation continuation retains one aggregate 3000-game budget"):
+    val plan = NoSweatStudyPlan.find("strength-validation-continuation-v1").get
+    assertEquals(plan.maximumAdmitted, 3000)
+    assertEquals(plan.maximumConcurrency, 22)
+    assertEquals(plan.workers, 2)
+    assertEquals(List(0, 2000, 2999, 3000).map(plan.capacity), List.fill(4)(22))
+
+  test("the new rating establishment has a separate 3000-game budget and fixed resource plan"):
+    val plan = NoSweatStudyPlan.find("rating-establishment-v1").get
+    assertEquals(plan.maximumAdmitted, 3000)
+    assertEquals(plan.maximumConcurrency, 22)
+    assertEquals(plan.workers, 2)
+    assertEquals(List(0, 2000, 2999, 3000).map(plan.capacity), List.fill(4)(22))
+    val start = NoSweatStudyPlan.establishmentStart
+    assert(plan.establishmentAdmission(start, start, 0))
+    assert(plan.establishmentAdmission(start, start, 2999))
+    assert(!plan.establishmentAdmission(start, start, 3000))
+    assert(!plan.establishmentAdmission(start, start, -1))
+
+  test("the overnight scope cannot reopen old public runs or use another private fixture"):
+    val plan = NoSweatStudyPlan.find("rating-establishment-v1").get
+    val start = NoSweatStudyPlan.establishmentStart
+    assert(plan.establishmentScope("r20261031n163", true, start))
+    assert(plan.establishmentScope("q20261031n163", false, start))
+    assert(!plan.establishmentScope("r20261031p137", true, start))
+    assert(!plan.establishmentScope("r20261031n163", false, start))
+    assert(!plan.establishmentScope("q20261031n163", true, start))
+    assert(!plan.establishmentScope("q20261031p137", false, start))
+
+  test("overnight preparation consumes the fixed eight-hour window without extending deadlines"):
+    val plan = NoSweatStudyPlan.find("rating-establishment-v1").get
+    val start = NoSweatStudyPlan.establishmentStart
+    val admissions = NoSweatStudyPlan.establishmentAdmissionEnd
+    val deadline = NoSweatStudyPlan.establishmentDeadline
+    assertEquals(deadline - start, 8L * 60 * 60000)
+    assertEquals(deadline - admissions, 30L * 60000)
+    assert(!plan.establishmentScope("r20261031n163", true, start - 1))
+    assert(!plan.establishmentScope("r20261031n163", true, admissions))
+    assert(plan.establishmentScope("r20261031n163", true, start + 60 * 60000))
+    assert(!plan.establishmentAdmission(start - 1, start, 0))
+    assert(plan.establishmentAdmission(admissions - 1, start, 2999))
+    assert(!plan.establishmentAdmission(admissions, start, 0))
+    assert(!plan.establishmentAdmission(deadline, start, 0))
+
+  test("earlier profiles cannot use the overnight scope or its admission hook"):
+    for key <- List(
+        "pilot-10-v1",
+        "ramp-22-v1",
+        "calibration-200-v1",
+        "strength-predictor-v1",
+        "strength-validation-continuation-v1"
+      )
+    do
+      val plan = NoSweatStudyPlan.find(key).get
+      assert(!plan.ratingEstablishment)
+      assert(!plan.establishmentScope("r20261031n163", true, NoSweatStudyPlan.establishmentStart))
+      assert(
+        !plan.establishmentAdmission(
+          NoSweatStudyPlan.establishmentStart,
+          NoSweatStudyPlan.establishmentStart,
+          0
+        )
+      )
