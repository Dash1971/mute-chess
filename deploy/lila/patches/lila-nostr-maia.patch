@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import { mock, test } from 'node:test';
+
+import type AnalyseCtrl from '../src/ctrl';
+import type { Review } from '../src/noSweatFish';
+
+const jobs: { signal: AbortSignal; resolve: (r: Review) => void }[] = [];
+class FakeFish {
+  search(_fen: string, _moves: string[], signal: AbortSignal) {
+    return new Promise<Review>(resolve => jobs.push({ signal, resolve }));
+  }
+  destroy() {}
+}
+mock.module('../src/noSweatFish.ts', { namedExports: { ReviewFish: FakeFish } });
+const { NoSweatAnalysis } = await import('../src/noSweatAnalysis');
+const fen = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1';
+
+test('turning analysis off invalidates an in-flight candidate color result', async () => {
+  const ctrl = {
+    cevalEnabled: () => false,
+    ceval: { storedPv: () => {} },
+    opts: {},
+    node: { fen, children: [] },
+    nodeList: [{ fen }],
+    path: '',
+    isCevalAllowed: () => true,
+    setAutoShapes: () => {},
+    redraw: () => {},
+    threatMode: () => false,
+  } as unknown as AnalyseCtrl;
+  const model = new NoSweatAnalysis(ctrl);
+  await Promise.resolve();
+  model.enabled = true;
+  model.candidates = [{ uci: 'e2e4', probability: 1 }];
+  (model as any).colorCandidates();
+  assert.equal(jobs.length, 1);
+  model.setEnabled(false);
+  assert.equal(jobs[0].signal.aborted, true);
+  jobs[0].resolve({ current: { depth: 12, lines: [{ cp: 0, moves: ['e2e4'] }] } });
+  await new Promise(resolve => setTimeout(resolve, 0));
+  assert.equal(model.scores.size, 0);
+  assert.equal((model as any).moveQuality('e2e4'), undefined);
+  model.release();
+});
diff --git a/ui/analyse/tests/candidateQuality.test.ts b/ui/analyse/tests/candidateQuality.test.ts
new file mode 100644
index 0000000..29b7dee
--- /dev/null
+++ b/ui/analyse/tests/candidateQuality.test.ts
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { candidateQuality, qualityFromLoss } from '../src/noSweatCandidateQuality';
+
+test('Maia-platform boundaries use five and ten percentage points of SF winrate loss', () => {
+  assert.equal(qualityFromLoss(0.05), 'good');
+  assert.equal(qualityFromLoss(0.05001), 'ok');
+  assert.equal(qualityFromLoss(0.1), 'ok');
+  assert.equal(qualityFromLoss(0.10001), 'blunder');
+  assert.equal(candidateQuality({ cp: 0 }, { cp: 0 }, true), 'good');
+  assert.equal(candidateQuality({ cp: 0 }, { cp: -100 }, true), 'ok');
+  assert.equal(candidateQuality({ cp: 0 }, { cp: -500 }, true), 'blunder');
+});
+test('quality has the same mover perspective for Black and White, with honest missing evidence', () => {
+  assert.equal(candidateQuality({ cp: 0 }, { cp: 500 }, false), 'blunder');
+  assert.equal(candidateQuality({ cp: 0 }, { cp: -500 }, false), 'good');
+  assert.equal(candidateQuality(undefined, { cp: 0 }, true), undefined);
+  assert.equal(candidateQuality({ cp: 0 }, undefined, true), undefined);
+  assert.equal(candidateQuality({ cp: 0 }, { cp: NaN }, true), undefined);
+  assert.equal(candidateQuality({ mate: 2 }, { mate: -2 }, true), 'blunder');
+  assert.equal(candidateQuality({ mate: -2 }, { mate: 2 }, false), 'blunder');
+  assert.equal(candidateQuality({ mate: 2 }, { mate: 4 }, true), 'good');
+});
