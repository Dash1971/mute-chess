diff --git a/public/nosweat/brand.css b/public/nosweat/brand.css
new file mode 100644
index 0000000..7b51bd8
--- /dev/null
+++ b/public/nosweat/brand.css
@@ -0,0 +1,162 @@
+.site-title .nosweat-header-icon{width:38px;height:38px;margin-right:2px}.site-title .nosweat-wordmark{width:174px;height:50px;object-fit:contain}.nosweat-light{display:none}.light .nosweat-dark{display:none}.light .nosweat-light{display:block}.nosweat-login-wordmark{width:272px;max-width:100%;height:62px}.auth__brand{justify-content:center}@media(max-width:799px){.site-title .nosweat-wordmark{display:none!important}.site-title .nosweat-header-icon{width:36px;height:36px;margin:0}}
+
+main.lobby .lobby__app__content{background-image:url("/assets/nosweat/watermark-dark.svg")}.light main.lobby .lobby__app__content{background-image:url("/assets/nosweat/watermark-light.svg")}
+
+
+.nosweat-bot-policy { margin:1em 0; max-width:32em; }
+.nosweat-bot-policy h2 { font-size:1.1em; margin-bottom:.6em; }
+.nosweat-bot-policy table { width:100%; border-collapse:collapse; }
+.nosweat-bot-policy th,.nosweat-bot-policy td { text-align:left; padding:.3em .6em .3em 0; vertical-align:top; }
+.nosweat-bot-policy th { font-weight:normal; color:var(--c-font-dim); width:40%; }
+.nosweat-bot-policy p { color:var(--c-font-dim); font-size:.85em; margin:.7em 0; }
+.nosweat-analysis { padding:.7em; border-bottom:1px solid var(--c-border); font-size:.85em; max-height:48vh; overflow:auto; flex-shrink:0; }
+.nosweat-analysis__heading,.nosweat-analysis__settings,.nosweat-analysis__options,.nosweat-analysis__actions { display:flex; flex-wrap:wrap; align-items:center; gap:.4em .7em; }
+.nosweat-analysis__heading { justify-content:space-between; }
+.nosweat-analysis__note { color:var(--c-font-dim); margin:.5em 0; }
+.nosweat-analysis__settings label { display:flex; align-items:center; gap:.3em; }
+.nosweat-analysis select { max-width:13em; padding:.25em; }
+.nosweat-analysis input[type=checkbox] { margin-right:.3em; }
+.nosweat-analysis small { display:block; color:var(--c-font-dim); font-size:.85em; }
+.nosweat-analysis table { width:100%; text-align:right; border-collapse:collapse; margin:.5em 0; }
+.nosweat-analysis td,.nosweat-analysis th { padding:.3em; border-bottom:1px solid var(--c-border); }
+.nosweat-analysis td:first-child,.nosweat-analysis th:first-child { text-align:left; }
+.nosweat-analysis button { padding:.3em .5em; }
+.nosweat-analysis__actions { margin:.5em 0; }
+.nosweat-rating-scroll { overflow:auto; }
+.nosweat-analysis .error { color:var(--c-bad); }
+
+.nosweat-candidates button,.nosweat-ratings button { text-transform:none; }
+cg-board square.nosweat-premove-origin { background:rgb(20 30 85 / .16); }
+cg-board square.nosweat-premove-dest { background:rgb(20 30 85 / .28); }
+
+.nosweat-engine-settings .setting { display:flex; align-items:center; justify-content:space-between; gap:1em; padding:.35em 0; }
+.nosweat-engine-settings select { max-width:13em; padding:.3em; }
+.nosweat-engine-settings small { display:block; margin-top:.7em; color:var(--c-font-dim); }
+.nosweat-game-review { padding:1em; background:var(--c-bg-box); border-radius:4px; }
+.nosweat-review-heading { display:flex; align-items:center; justify-content:space-between; gap:1em; margin-bottom:.7em; }
+.nosweat-review-heading h2 { margin:0; font-size:1.15em; }
+.nosweat-game-review table { width:100%; text-align:center; border-collapse:collapse; margin:.6em 0; }
+.nosweat-game-review th:first-child { text-align:left; }
+.nosweat-game-review th,.nosweat-game-review td { padding:.3em .5em; border-bottom:1px solid var(--c-border); }
+.nosweat-accuracy td { font-size:1.5em; }
+.nosweat-classifications button { min-width:3em; padding:.15em .5em; }
+.nosweat-review-graph { width:100%; max-height:150px; color:var(--c-font); background:var(--c-bg-low); }
+.nosweat-review-graph a:focus circle { stroke:var(--c-primary); stroke-width:3; }
+.nosweat-computed-glyph { font-weight:bold; margin-left:.12em; }
+.nosweat-computed-glyph.brilliant { color:#15aabf; }
+/* Chessground 10.5 paints this badge inline; match Mobile Maia without changing its geometry. */
+.analyse { --c-brilliant:#15aabf; }
+.analyse .cg-custom-svgs circle[fill="#168226"] { fill:#15aabf; }
+.nosweat-computed-glyph.good { color:#12b886; }
+.nosweat-computed-glyph.interesting { color:#82c91e; }
+.nosweat-computed-glyph.dubious { color:#fab005; }
+.nosweat-computed-glyph.mistake { color:#fd7e14; }
+.nosweat-computed-glyph.blunder { color:#fa5252; }
+
+/* Keep the entry page focused on choosing a time control. */
+.lobby.mutechess-play { width:100%; max-width:64em; margin-inline:auto; grid-template-columns:minmax(0,1fr); grid-template-rows:auto; grid-template-areas:'app' 'about'; }
+.mutechess-play .lobby__table { display:contents; }
+.mutechess-play .lobby__about { margin-top:1.5em; justify-content:center; }
+.nosweat-rating-explorer h3 { margin:.8em 0 .4em; font-size:1.1em; }
+.nosweat-rating-chart svg { width:100%; display:block; overflow:visible; }
+.nosweat-chart-legend { justify-content:flex-end; gap:.5em; }
+.nosweat-chart-legend .fbt { padding:.15em .3em; }
+.nosweat-rating-chart [role=button]:focus-visible { outline:2px solid currentColor; }
+.nosweat-rating-explorer details { margin-top:.5em; }
+.mutechess-info { max-width:52em; margin-inline:auto; line-height:1.7; overflow-wrap:anywhere; }
+.mutechess-info nav { display:flex; flex-wrap:wrap; gap:1em; margin-bottom:1.5em; }
+.mutechess-info h2 { margin-top:1.5em; }
+
+/* Accepted compact analysis: reserve frames while only content changes. */
+.nosweat-candidate-panel { min-width:0; margin-bottom:.5em; }
+.nosweat-maia-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
+.nosweat-maia-cards:has(> :only-child) { grid-template-columns:1fr; }
+.nosweat-maia-card { min-width:0; height:184px; display:grid; grid-template-rows:30px minmax(0,1fr) 28px; background:var(--c-bg-box); border-radius:5px; overflow:hidden; }
+.nosweat-maia-card header { display:flex; align-items:center; justify-content:space-between; gap:3px; padding:0 9px; white-space:nowrap; }
+.nosweat-maia-label { font-weight:bold; padding:0; border-radius:3px; text-align:left; font-size:12px; white-space:nowrap; }
+.nosweat-maia-label:hover { text-decoration:underline; text-underline-offset:.25em; }
+.nosweat-score { display:inline-flex; align-items:center; gap:3px; font-size:11px; white-space:nowrap; font-variant-numeric:tabular-nums; }
+.nosweat-score i { width:.65em; height:.65em; flex:0 0 .65em; border-radius:50%; border:1px solid #999; }
+.nosweat-score-side.white { background:#fff; }
+.nosweat-score-side.black { background:#111; }
+.nosweat-policy-scroll { min-height:0; overflow:auto; scrollbar-width:thin; scrollbar-gutter:stable; }
+.nosweat-policy { width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; }
+.nosweat-policy th { height:22px; font-size:11px; font-weight:normal; color:var(--c-font-dim); padding:0 9px; }
+.nosweat-policy th:first-child,.nosweat-policy td:first-child { text-align:left; }
+.nosweat-policy th:last-child,.nosweat-policy td:last-child { text-align:right; }
+.nosweat-policy td { height:24px; padding:0 9px; font-size:13px; white-space:nowrap; }
+.nosweat-policy button { color:var(--c-font); text-transform:none; padding:0; line-height:24px; }
+.nosweat-policy-placeholder { color:var(--c-font-dim); }
+.nosweat-policy-placeholder td:first-child { font-size:11px; }
+.nosweat-others { display:flex; align-items:center; justify-content:space-between; gap:3px; padding:0 9px; font-size:11px; width:100%; border-top:1px solid var(--c-border); color:var(--c-font-dim); }
+.nosweat-others:hover:not(:disabled) { background:var(--c-bg-low); }
+.nosweat-others:disabled { opacity:1; cursor:default; }
+.nosweat-rating-explorer { background:var(--c-bg-box); padding:8px 10px; border-radius:5px; margin-top:8px; height:190px; display:grid; grid-template-rows:25px minmax(0,1fr); }
+.nosweat-rating-heading { display:flex; align-items:baseline; gap:10px; min-width:0; }
+.nosweat-rating-heading h3 { margin:0; font-size:13px; white-space:nowrap; }
+.nosweat-chart-legend { display:flex; align-items:center; justify-content:start; gap:7px; min-width:0; flex:1; overflow-x:auto; overflow-y:hidden; padding:2px; scrollbar-width:thin; }
+.nosweat-chart-legend .fbt { flex:0 0 auto; padding:0; font-size:12px; text-transform:none; }
+.nosweat-rating-chart { min-width:0; min-height:0; position:relative; }
+.nosweat-rating-chart svg { width:100%; height:100%; display:block; }
+.nosweat-rating-tooltip { position:absolute; top:5px; right:36px; min-width:118px; padding:7px 9px; background:var(--c-bg-box); border:1px solid var(--c-border); border-radius:4px; box-shadow:0 3px 12px #0006; font-size:11px; font-variant-numeric:tabular-nums; z-index:3; pointer-events:none; }
+.nosweat-rating-tooltip[hidden] { display:none; }
+.nosweat-rating-tooltip strong { display:block; margin-bottom:3px; color:var(--c-font); }
+.nosweat-rating-tooltip-row { display:flex; justify-content:space-between; gap:16px; line-height:17px; white-space:nowrap; }
+.nosweat-chart-legend button:focus-visible { outline:2px solid currentColor; outline-offset:1px; }
+.nosweat-maia-feedback { height:22px; padding:2px 3px; font-size:11px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
+.nosweat-return { margin:0; padding:0; font-size:11px; }
+.nosweat-rating-dialog { width:min(24em,90vw); padding:1.5em; }
+.nosweat-rating-dialog h2 { margin:0 0 1em; font-size:1.4em; }
+.nosweat-rating-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.4em; }
+.nosweat-rating-grid button { padding:.65em .3em; border-radius:4px; background:var(--c-bg-low); }
+.nosweat-rating-grid button[aria-pressed=true] { background:var(--c-primary); color:var(--c-primary-over); }
+.nosweat-summary table { table-layout:fixed; width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; }
+.nosweat-summary th { color:var(--c-font-dim); font-weight:normal; padding:.4em .15em; text-align:center; vertical-align:bottom; width:25%; }
+.nosweat-summary th:nth-child(2) { width:50%; }
+.nosweat-summary-player { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.nosweat-summary-player a { display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; }
+.nosweat-summary td { padding:.3em .15em; text-align:center; line-height:1.5; }
+.nosweat-summary td:nth-child(2) { white-space:nowrap; font-size:.95em; }
+.nosweat-summary-label { display:inline-grid; grid-template-columns:1.8em minmax(0,1fr); align-items:baseline; column-gap:.65em; width:10em; max-width:100%; text-align:left; }
+.nosweat-summary-symbol { text-align:center; font-weight:bold; }
+.nosweat-summary td button { min-width:2em; padding:.15em; }
+.nosweat-summary .accuracy td { border-top:1px solid var(--c-border); padding-top:.5em; font-weight:bold; }
+.nosweat-summary > .button { margin-top:.7em; font-size:.85em; }
+.nosweat-opening { height:28px; min-height:28px; min-width:0; display:flex; align-items:center; margin:0 0 3px; box-sizing:border-box; padding-inline:min(50%, var(--nosweat-opening-clearance, 0px)); }
+.nosweat-opening-name { width:100%; min-width:0; padding:0 12px 8px; font-size:13px; line-height:20px; background:none; color:var(--c-font-dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align:center; text-transform:none; cursor:default; }
+.nosweat-opening-name.truncated { cursor:pointer; }
+.nosweat-opening-name:disabled { opacity:1; cursor:default; }
+.nosweat-opening-name.truncated:hover { color:var(--c-font); }
+.nosweat-opening-dialog { width:min(36em,90vw); padding:1.5em; overflow-wrap:anywhere; }
+.nosweat-opening-dialog h2 { font-size:1.3em; margin-bottom:1em; }
+.nosweat-opening-dialog p { margin-bottom:1.5em; }
+.analysis-chart.nosweat-chart { display:flex; flex-direction:column; }
+.nosweat-chart .analysis-chart-actions { position:static; inset:auto; flex:0 0 32px; height:32px; align-items:center; border-bottom:1px solid var(--c-border); padding:3px 7px; }
+.analyse__underboard .nosweat-chart .analysis-chart-actions :is(i,button) { margin:0; padding:3px; border:0; background:none; }
+.nosweat-chart .analysis-chart-plot { flex:1; min-height:0; position:relative; }
+.nosweat-review-settings { margin-top:1.5em; }
+.nosweat-review-quality { display:flex; gap:1em; flex-wrap:wrap; margin:1em 0; }
+.nosweat-review-quality label { display:flex; align-items:center; gap:.4em; }
+
+/* Candidate quality is Stockfish evidence, independent of model probability. */
+.nosweat-policy button[data-quality=good] { color:#74c476; }
+.nosweat-policy button[data-quality=ok] { color:#fed976; }
+.nosweat-policy button[data-quality=blunder] { color:#ff9292; }
+.nosweat-policy button[data-blunder-rank="1"] { color:#ff7777; }
+.nosweat-policy button[data-blunder-rank="2"] { color:#ff5b5b; }
+.nosweat-policy button[data-blunder-rank="3"] { color:#f43d3d; }
+.nosweat-policy button[data-blunder-rank="4"] { color:#df2828; }
+.light .nosweat-policy button[data-quality=good] { color:#238b45; }
+.light .nosweat-policy button[data-quality=ok] { color:#975000; }
+.light .nosweat-policy button[data-quality=blunder] { color:#b82842; }
+.light .nosweat-policy button[data-blunder-rank="1"] { color:#b51f39; }
+.light .nosweat-policy button[data-blunder-rank="2"] { color:#b71830; }
+.light .nosweat-policy button[data-blunder-rank="3"] { color:#bb122d; }
+.light .nosweat-policy button[data-blunder-rank="4"] { color:#bf0829; }
+.nosweat-key-field { display:flex; gap:.5em; align-items:center; margin:1em 0; }
+.nosweat-key-field input { min-width:0; flex:1; font-family:monospace; }
+#nostr-keys h2 { margin-top:1.5em; }
+#nostr-keys label { display:flex; gap:.5em; align-items:baseline; }
+
+
+.analyse .game__meta__players .player { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
