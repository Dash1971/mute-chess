+          data.has(2600) &&
+            hl(
+              'text',
+              {
+                attrs: {
+                  x: 358,
+                  y: chartY(data.get(2600)!.find(m => m.uci === uci)?.probability ?? 0) + 4,
+                  fill: colors[index],
