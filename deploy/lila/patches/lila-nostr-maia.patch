diff --git a/app/NoSweatService.scala b/app/NoSweatService.scala
new file mode 100644
index 0000000..eca4f0a
--- /dev/null
+++ b/app/NoSweatService.scala
@@ -0,0 +1,221 @@
+package lila.app
+
+import java.nio.file.Files
+import java.util.concurrent.atomic.{ AtomicLong, AtomicReference }
+import play.api.libs.json.*
+import play.api.libs.ws.StandaloneWSClient
+import play.api.libs.ws.DefaultBodyWritables.writeableOf_String
+import chess.{ ByColor, Clock, Color, Rated }
+import lila.core.config.CollName
+import lila.core.game.{ GameRule, Source, WithInitialFen }
+import lila.core.perf.PerfKey
+import lila.db.dsl.{ *, given }
+
+final case class NoSweatError(status: Int, reason: String) extends RuntimeException(reason)
+
+/** Identity and bot admission adapters. Round state remains authoritative in Lila. */
+final class NoSweatService(env: Env, ws: StandaloneWSClient)(using ec: Executor):
+  private given Scheduler = env.system.scheduler
+  val enabled = env.config.getOptional[Boolean]("nosweat.enabled").getOrElse(false)
+  private lazy val adapterUrl = env.config.get[String]("nosweat.adapterUrl")
+  private lazy val token = env.config.get[String]("nosweat.adapterToken")
+  private val records = env.mongo.mainDb(CollName("nosweat_game"))
+  private val lastPoll = AtomicLong(System.currentTimeMillis())
+  private val lastOnline = AtomicLong(0L)
+  private val adapterInstance = AtomicReference("")
+  private val connectedBots = java.util.concurrent.ConcurrentHashMap.newKeySet[GameId]()
+  private val queue = scalalib.actor.AsyncActorSequencer(
+    maxSize = Max(32), timeout = 20.seconds, "noSweatAdmission", lila.mon.asyncActorMonitor.full
+  )
+  lazy val roster: List[JsObject] = Json.parse(
+    Files.readString(env.getFile.exec("public/nosweat-roster.json").toPath)
+  ).as[List[JsObject]]
+  private def botId(bot: JsObject): UserId = UserId((bot \ "username").as[String].toLowerCase)
+  private def requireThat(ok: Boolean, status: Int, message: String): Unit =
+    if !ok then throw NoSweatError(status, message)
+
+  def internalAuthorized(header: Option[String]): Boolean = enabled && header.exists: value =>
+    java.security.MessageDigest.isEqual(
+      value.getBytes(java.nio.charset.StandardCharsets.UTF_8),
+      s"Bearer $token".getBytes(java.nio.charset.StandardCharsets.UTF_8)
+    )
+
+  def adapter(path: String, body: JsValue): Fu[JsValue] =
+    ws.url(s"$adapterUrl$path").withHttpHeaders("Authorization" -> s"Bearer $token", "Content-Type" -> "application/json")
+      .withRequestTimeout(5.seconds).post(Json.stringify(body)).map: response =>
+        val result = Json.parse(response.body)
+        if response.status != 200 then
+          throw NoSweatError(response.status, (result \ "error").asOpt[String].getOrElse("Adapter unavailable"))
+        result
+
+  private def initialize(): Funit =
+    roster.foldLeft(funit): (previous, bot) =>
+      previous.flatMap: _ =>
+        val name = UserName((bot \ "username").as[String])
+        for
+          existing <- env.user.repo.byId(name.id)
+          loaded <- existing.fold(env.user.repo.createNoSweatBot(name))(u => fuccess(u.some))
+          user = loaded.getOrElse(throw NoSweatError(503, "Could not provision bot"))
+          doc <- env.user.repo.withColl(_.byId[Bdoc](name.id))
+          _ = requireThat(user.isBot && doc.exists(_.getAsOpt[Boolean]("noSweatBot").contains(true)),
+            503, "A roster name is occupied by an account outside the club roster")
+          _ <- if doc.exists(_.getAsOpt[String]("noSweatSeedVersion").isDefined) then funit
+            else
+              List(("blitz", PerfKey.blitz), ("rapid", PerfKey.rapid)).foldLeft(funit): (prev, entry) =>
+                prev.flatMap: _ =>
+                  val prior = (bot \ "ratings" \ entry._1)
+                  val perf = lila.rating.Perf.default.copy(
+                    glicko = new chess.rating.glicko.Glicko(
+                      (prior \ "initial_rating").as[Double], (prior \ "initial_rd").as[Double], 0.09
+                    ), latest = nowInstant.some)
+                  env.user.perfsRepo.setPerf(user.id, entry._2, perf)
+              .flatMap(_ => env.user.repo.withColl(_.update.one(bid(name.id), set("noSweatSeedVersion" -> "roster-priors-v1")).void))
+        yield env.user.lightUserApi.invalidate(user.id)
+    .flatMap: _ =>
+      // A process restart never guesses how much time unfinished games lost.
+      records.find(bdoc("state" -> bdoc("$in" -> List("reserved", "active"))))
+        .cursor[Bdoc]().list(100).flatMap: docs =>
+          docs.foldLeft(funit)((prev, doc) => prev.flatMap(_ => failGame(doc.getAsOpt[GameId]("_id").get, "application_restart")))
+
+  val ready: Funit = if enabled then initialize() else funit
+
+  if enabled then
+    env.system.scheduler.scheduleWithFixedDelay(5.seconds, 5.seconds): () =>
+      if System.currentTimeMillis() - lastPoll.get() > 15000 then
+        ready.flatMap(_ => current()).foreach: games =>
+          games.foreach((doc, game) => failGame(game.id, "maia_adapter_unavailable"))
+
+  def nostrUser(pubkey: String, requested: Option[String]): Fu[UserModel] = queue:
+    ready.flatMap: _ =>
+      requireThat(pubkey.matches("[0-9a-f]{64}"), 401, "Invalid verified identity")
+      env.user.repo.byNostr(pubkey).flatMap:
+        case Some(user) =>
+          requireThat(user.enabled.yes && !user.isBot, 403, "Account unavailable")
+          fuccess(user)
+        case None =>
+          val name = requested.filter(_.nonEmpty).getOrElse("n" + pubkey.take(19))
+          requireThat(name.matches("[A-Za-z][A-Za-z0-9_-]{2,19}"), 400, "Use a 3–20 character username")
+          val reserved = Set("lichess", "ghost", "openingexplorer", "broadcaster", "irwin", "kaladin", "ai",
+            "lichess4545", "challengermode", "watcherbot", "taketaketakeapp", "undefined", "anonymous", "admin", "system", "nosweatchess")
+          requireThat(!reserved.contains(name.toLowerCase), 409, "That is a reserved system name")
+          requireThat(!roster.exists(botId(_).value == name.toLowerCase), 409, "That name belongs to a Maia opponent")
+          env.user.repo.existsPri(UserName(name).id).flatMap: occupied =>
+            requireThat(!occupied, 409, "Username already taken")
+            env.user.repo.createNostr(UserName(name), pubkey).map:
+              _.getOrElse(throw NoSweatError(503, "Could not create identity"))
+
+  def isNostr(user: UserModel): Fu[Boolean] =
+    env.user.repo.withColl(_.exists(bdoc("_id" -> user.id, "nostr" -> bdoc("$exists" -> true))))
+
+  private def current(): Fu[List[(Bdoc, GameModel)]] =
+    records.find(bdoc("state" -> "active")).cursor[Bdoc]().list(100).flatMap: docs =>
+      docs.traverse: doc =>
+        env.round.proxyRepo.game(doc.getAsOpt[GameId]("_id").get).flatMap:
+          case Some(game) if game.playable => fuccess((doc -> game).some)
+          case _ =>
+            connectedBots.remove(doc.getAsOpt[GameId]("_id").get)
+            records.update.one(bid(doc.getAsOpt[GameId]("_id").get), set("state" -> "finished")).map(_ => none)
+      .map(_.flatten)
+
+  def play(user: UserModel, data: JsValue): Fu[JsObject] = queue:
+    for
+      _ <- ready
+      identity <- isNostr(user)
+      _ = requireThat(identity && !user.isBot, 403, "Sign in with Nostr first")
+      games <- current()
+      existing = games.find(_._1.getAsOpt[UserId]("human").contains(user.id))
+      result <- existing match
+        case Some((_, game)) => fuccess(playerLink(game, user.id))
+        case None =>
+          requireThat(games.size < 2, 503, "Private alpha is full; try again after a game finishes")
+          val slug = (data \ "bot").asOpt[String].getOrElse("")
+          val bot = roster.find(b => (b \ "id").as[String] == slug)
+            .getOrElse(throw NoSweatError(400, "Choose a club opponent"))
+          val control = (data \ "control").asOpt[String].getOrElse("blitz")
+          requireThat(Set("blitz", "rapid").contains(control), 400, "Choose 5+3 or 10+5")
+          val color = (data \ "color").asOpt[String].getOrElse("random")
+          requireThat(Set("white", "black", "random").contains(color), 400, "Invalid color")
+          val humanColor = if color == "random" then Color.fromWhite(scalalib.SecureRandom.nextInt(2) == 0)
+            else Color.fromWhite(color == "white")
+          val clock = Clock.Config(Clock.LimitSeconds(if control == "blitz" then 300 else 600),
+            Clock.IncrementSeconds(if control == "blitz" then 3 else 5))
+          val perfKey = if control == "blitz" then PerfKey.blitz else PerfKey.rapid
+          for
+            policy <- adapter("/freeze", Json.obj("bot" -> slug))
+            human <- env.user.api.byIdWithPerf(user.id, perfKey)
+            opponent <- env.user.api.byIdWithPerf(botId(bot), perfKey)
+            _ = requireThat(opponent.exists(_.user.isBot), 503, "Opponent is unavailable")
+            id <- env.game.idGenerator.game
+            game = lila.core.game.newGame(
+              chess = chess.Game(position = chess.variant.Standard.initialPosition, clock = clock.toClock.start.some),
+              players = ByColor(c => lila.game.Player.make(c, if c == humanColor then human else opponent)),
+              rated = Rated.No, source = Source.Friend, pgnImport = None,
+              rules = Set(GameRule.noRematch, GameRule.noGiveTime, GameRule.noClaimWin)
+            ).withId(id).start
+            _ <- records.insert.one(bdoc("_id" -> id, "human" -> user.id, "bot" -> botId(bot),
+              "slug" -> slug, "state" -> "reserved", "snapshot" -> Json.stringify(policy),
+              "createdAt" -> nowInstant, "control" -> control, "prior" -> Json.stringify((bot \ "ratings" \ control).get)))
+            _ <- env.game.gameRepo.insertDenormalized(game)
+            _ <- env.round.onStart.exec(id)
+            _ <- records.update.one(bid(id), set("state" -> "active"))
+          yield playerLink(game, user.id)
+    yield result
+
+  private def playerLink(game: GameModel, userId: UserId): JsObject =
+    Json.obj("id" -> game.id.value, "url" -> s"/${game.fullIdOf(game.player(userId).get.color).value}", "rated" -> false)
+
+  def games(instance: Option[String]): Fu[JsValue] =
+    val restarted = instance.filter(_.matches("[0-9a-f-]{36}")).exists: next =>
+      lastPoll.set(System.currentTimeMillis())
+      val previous = adapterInstance.getAndSet(next)
+      previous.nonEmpty && previous != next
+    if System.currentTimeMillis() - lastOnline.get() > 5000 then
+      lastOnline.set(System.currentTimeMillis())
+      roster.foreach(bot => env.bot.onlineApiUsers.setOnline(botId(bot)))
+    val recover = if !restarted then funit else ready.flatMap(_ => current()).flatMap: games =>
+      games.foldLeft(funit)((prev, entry) => prev.flatMap(_ => failGame(entry._2.id, "maia_adapter_restart")))
+    ready.flatMap(_ => recover).flatMap(_ => current()).flatMap: games =>
+      games.traverse: (doc, game) =>
+        env.bot.jsonView.gameState(WithInitialFen(game, None)).map: state =>
+          val bot = doc.getAsOpt[UserId]("bot").get
+          if connectedBots.add(game.id) then
+            env.round.roundApi.tell(game.id, lila.core.round.RoundBus.BotConnected(game.player(bot).get.color, true))
+          Json.obj("id" -> game.id.value, "ply" -> game.ply.value,
+            "botToMove" -> game.player.userId.contains(bot), "botColor" -> game.player(bot).get.color.name,
+            "policy" -> Json.parse(doc.getAsOpt[String]("snapshot").get), "state" -> state)
+      .map(Json.toJson(_))
+
+  def move(id: GameId, ply: Int, uci: String, timing: JsObject): Funit =
+    for
+      record <- records.byId[Bdoc](id)
+      doc = record.getOrElse(throw NoSweatError(404, "No club game"))
+      botId = doc.getAsOpt[UserId]("bot").get
+      bot <- env.user.repo.byId(botId)
+      pov <- env.round.proxyRepo.pov(id, botId)
+      p = pov.getOrElse(throw NoSweatError(404, "No bot seat"))
+      _ = requireThat(doc.getAsOpt[String]("state").contains("active") && p.game.playable &&
+        p.game.ply.value == ply && p.isMyTurn && bot.exists(_.isBot), 409, "Game position changed")
+      _ <- env.bot.player.apply(p, uci, Some(false))(using Me(bot.get))
+      _ <- records.update.one(bid(id), set(s"moves.$ply" -> Json.stringify(
+        Json.obj("move" -> uci, "timing" -> timing, "at" -> nowInstant.toString))))
+    yield ()
+
+  def failGame(id: GameId, reason: String): Funit =
+    records.byId[Bdoc](id).flatMap:
+      case None => funit
+      case Some(doc) if !doc.getAsOpt[String]("state").exists(Set("active", "reserved").contains) => funit
+      case Some(_) =>
+        env.round.proxyRepo.game(id).flatMap:
+          case Some(game) if !game.playable =>
+            connectedBots.remove(id)
+            records.update.one(bid(id), set("state" -> "finished")).void
+          case _ =>
+            connectedBots.remove(id)
+            env.round.roundApi.tell(id, lila.core.round.RoundBus.AbortForce)
+            records.update.one(bid(id), set("state" -> "service_failure", "failure" -> reason.take(80))).void
+
+  def details(id: GameId, user: UserModel): Fu[Option[JsValue]] =
+    records.one[Bdoc](bid(id) ++ bdoc("human" -> user.id)).map2: doc =>
+      Json.obj("id" -> id.value, "state" -> doc.getAsOpt[String]("state"),
+        "failure" -> doc.getAsOpt[String]("failure"),
+        "policy" -> (Json.parse(doc.getAsOpt[String]("snapshot").get).as[JsObject] - "samplingSeed"))
