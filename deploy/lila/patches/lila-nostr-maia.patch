+              doc.getAsOpt[String]("state").contains("reserved") &&
+              doc.getAsOpt[UserId]("white").contains(game.whitePlayer.userId.get) &&
+              doc.getAsOpt[UserId]("black").contains(game.blackPlayer.userId.get)
