@@ -0,0 +1,41 @@
+package lila.core
+
+/** Public-key display only. Canonical usernames and Nostr identity remain unchanged. */
+object NostrName:
+  private val alphabet = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
+  private val generators = Array(0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3)
+
+  def npub(key: String): Option[String] = Option.when(key.matches("[0-9a-f]{64}")):
+    val words = scala.collection.mutable.ArrayBuffer.empty[Int]
+    var acc = 0
+    var bits = 0
+    key
+      .grouped(2)
+      .foreach: hex =>
+        acc = ((acc << 8) | Integer.parseInt(hex, 16)) & 0xffff
+        bits += 8
+        while bits >= 5 do
+          bits -= 5
+          words += ((acc >> bits) & 31)
+    if bits > 0 then words += ((acc << (5 - bits)) & 31)
+    val hrp = "npub"
+    val expanded = hrp.map(_.toInt >> 5) ++ Seq(0) ++ hrp.map(_.toInt & 31)
+    var checksum = 1
+    (expanded ++ words ++ Seq.fill(6)(0)).foreach: value =>
+      val top = checksum >>> 25
+      checksum = ((checksum & 0x1ffffff) << 5) ^ value
+      generators.indices.foreach: i =>
+        if ((top >>> i) & 1) != 0 then checksum ^= generators(i)
+    checksum ^= 1
+    hrp + "1" + words.map(alphabet(_)).mkString +
+      (0 until 6).map(i => alphabet((checksum >>> (5 * (5 - i))) & 31)).mkString
+
+  def display(username: String, chosen: Option[String], key: Option[String]): Option[String] =
+    chosen
+      .filter(_.nonEmpty)
+      .orElse:
+        key
+          .filter(k => username.equalsIgnoreCase("n" + k.take(19)))
+          .flatMap(npub)
+          .map: full =>
+            full.take(9) + "…" + full.takeRight(4)
diff --git a/modules/core/src/test/NostrNameTest.scala b/modules/core/src/test/NostrNameTest.scala
new file mode 100644
index 0000000..e3492f8
--- /dev/null
+++ b/modules/core/src/test/NostrNameTest.scala
@@ -0,0 +1,30 @@
+package lila.core
+
+class NostrNameTest extends munit.FunSuite:
+  test("NIP-19 encoding agrees with independent nostr-tools vectors"):
+    assertEquals(
+      NostrName.npub("00" * 32),
+      Some("npub1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqzqujme")
+    )
+    assertEquals(
+      NostrName.npub("11" * 32),
+      Some("npub1zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zyg3zygse4sl3h")
+    )
+    assertEquals(
+      NostrName.npub("ff" * 32),
+      Some("npub1lllllllllllllllllllllllllllllllllllllllllllllllllllsq7lrjw")
+    )
+
+  test("asymmetric public key retains every bit and checksum"):
+    assertEquals(
+      NostrName.npub("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"),
+      Some("npub1qy352euf40x77qfrg4ncn27dauqjx3t83x4ummcpydzk0zdtehhstefp92")
+    )
+
+  test("only generated Nostr handles receive the compact fallback"):
+    val key = "11" * 32
+    assertEquals(NostrName.display("n" + key.take(19), None, Some(key)), Some("npub1zyg3…sl3h"))
+    assertEquals(NostrName.display("Dash", None, Some(key)), None)
+    assertEquals(NostrName.display("n" + key.take(19), Some("My name"), Some(key)), Some("My name"))
+    assertEquals(NostrName.display("n" + key.take(19), None, None), None)
+    assertEquals(NostrName.npub("not-a-key"), None)
diff --git a/modules/user/src/test/PublicNameTest.scala b/modules/user/src/test/PublicNameTest.scala
new file mode 100644
index 0000000..9869ce0
--- /dev/null
+++ b/modules/user/src/test/PublicNameTest.scala
@@ -0,0 +1,16 @@
+package lila.user
+
+class PublicNameTest extends munit.FunSuite:
+  def bind(name: String, previous: Option[String] = None) =
+    UserForm.publicName(previous).withPrefix("name").bind(Map("name" -> name))
+
+  test("new public names are optional and limited to twenty characters"):
+    assertEquals(bind(""), Right(None))
+    assertEquals(bind("a" * 20), Right(Some("a" * 20)))
+    assert(bind("a" * 21).isLeft)
+
+  test("existing longer names survive unrelated profile edits without allowing new long names"):
+    val old = "PreviouslyChosenLongPublicName"
+    assertEquals(bind(old, Some(old)), Right(Some(old)))
+    assert(bind("a" * 21, Some(old)).isLeft)
+    assertEquals(bind("Short name", Some(old)), Right(Some("Short name")))
