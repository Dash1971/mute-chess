diff --git a/public/nosweat/brand.css b/public/nosweat/brand.css
new file mode 100644
index 0000000..0e55dff
--- /dev/null
+++ b/public/nosweat/brand.css
@@ -0,0 +1,45 @@
+.site-title .nosweat-header-icon{width:38px;height:38px;margin-right:7px}.site-title .nosweat-wordmark{width:174px;height:50px;object-fit:contain}.nosweat-light{display:none}.light .nosweat-dark{display:none}.light .nosweat-light{display:block}.nosweat-login-wordmark{width:272px;max-width:100%;height:62px}.auth__brand{justify-content:center}@media(max-width:799px){.site-title .nosweat-wordmark{display:none!important}.site-title .nosweat-header-icon{width:36px;height:36px;margin:0}}
+
+main.lobby .lobby__app__content{background-image:url("/assets/nosweat/watermark-dark.svg")}.light main.lobby .lobby__app__content{background-image:url("/assets/nosweat/watermark-light.svg")}
+
+
+.nosweat-analysis { padding:.7em; border-bottom:1px solid var(--c-border); font-size:.85em; max-height:48vh; overflow:auto; flex-shrink:0; }
+.nosweat-analysis__heading,.nosweat-analysis__settings,.nosweat-analysis__options,.nosweat-analysis__actions { display:flex; flex-wrap:wrap; align-items:center; gap:.4em .7em; }
+.nosweat-analysis__heading { justify-content:space-between; }
+.nosweat-analysis__note { color:var(--c-font-dim); margin:.5em 0; }
+.nosweat-analysis__settings label { display:flex; align-items:center; gap:.3em; }
+.nosweat-analysis select { max-width:13em; padding:.25em; }
+.nosweat-analysis input[type=checkbox] { margin-right:.3em; }
+.nosweat-analysis small { display:block; color:var(--c-font-dim); font-size:.85em; }
+.nosweat-analysis table { width:100%; text-align:right; border-collapse:collapse; margin:.5em 0; }
+.nosweat-analysis td,.nosweat-analysis th { padding:.3em; border-bottom:1px solid var(--c-border); }
+.nosweat-analysis td:first-child,.nosweat-analysis th:first-child { text-align:left; }
+.nosweat-analysis button { padding:.3em .5em; }
+.nosweat-analysis__actions { margin:.5em 0; }
+.nosweat-rating-scroll { overflow:auto; }
+.nosweat-analysis .error { color:var(--c-bad); }
+
+.nosweat-candidates button,.nosweat-ratings button { text-transform:none; }
+cg-board square.nosweat-premove-origin { background:rgb(20 30 85 / .16); }
+cg-board square.nosweat-premove-dest { background:rgb(20 30 85 / .28); }
+
+.nosweat-engine-settings .setting { display:flex; align-items:center; justify-content:space-between; gap:1em; padding:.35em 0; }
+.nosweat-engine-settings select { max-width:13em; padding:.3em; }
+.nosweat-engine-settings small { display:block; margin-top:.7em; color:var(--c-font-dim); }
+.nosweat-game-review { padding:1em; background:var(--c-bg-box); border-radius:4px; }
+.nosweat-review-heading { display:flex; align-items:center; justify-content:space-between; gap:1em; margin-bottom:.7em; }
+.nosweat-review-heading h2 { margin:0; font-size:1.15em; }
+.nosweat-game-review table { width:100%; text-align:center; border-collapse:collapse; margin:.6em 0; }
+.nosweat-game-review th:first-child { text-align:left; }
+.nosweat-game-review th,.nosweat-game-review td { padding:.3em .5em; border-bottom:1px solid var(--c-border); }
+.nosweat-accuracy td { font-size:1.5em; }
+.nosweat-classifications button { min-width:3em; padding:.15em .5em; }
+.nosweat-review-graph { width:100%; max-height:150px; color:var(--c-font); background:var(--c-bg-low); }
+.nosweat-review-graph a:focus circle { stroke:var(--c-primary); stroke-width:3; }
+.nosweat-computed-glyph { font-weight:bold; margin-left:.12em; }
+.nosweat-computed-glyph.brilliant { color:#15aabf; }
+.nosweat-computed-glyph.good { color:#12b886; }
+.nosweat-computed-glyph.interesting { color:#82c91e; }
+.nosweat-computed-glyph.dubious { color:#fab005; }
+.nosweat-computed-glyph.mistake { color:#fd7e14; }
+.nosweat-computed-glyph.blunder { color:#fa5252; }
