+++ b/ui/lib/src/nosweat/arrows.ts
@@ -0,0 +1,82 @@
+// Mobile Maia review.dart / ReviewBoardOverlayPainter, AGPL-3.0.
+import type { DrawShape } from '@lichess-org/chessground/draw';
+export const engineColors = {
+  stockfish: '#3d9be9',
+  stockfishSecond: '#8ac8f5',
+  maia: '#e89b3c',
+  maiaSecond: '#e85d68',
+};
+export interface EngineArrow {
+  uci: string;
+  tail: string[];
+  head: string[];
+  width: number;
+}
+const valid = (uci?: string): uci is string => !!uci && /^[a-h][1-8][a-h][1-8][qrbn]?$/.test(uci);
+// Each Maia channel contributes ONE top move, not its top three probabilities.
+export function engineArrows(
+  stockfish: { uci: string; width?: number }[],
+  primary?: string,
+  secondary?: string,
+): EngineArrow[] {
+  const sf = [
+    ...new Map(
+      stockfish
+        .filter(s => valid(s.uci))
+        .slice(0, 2)
+        .map(s => [s.uci, s]),
+    ).values(),
+  ];
+  const maia = new Map<string, string[]>();
+  for (const [move, color] of [
+    [primary, engineColors.maia],
+    [secondary, engineColors.maiaSecond],
+  ] as const)
+    if (valid(move)) maia.set(move, [...(maia.get(move) ?? []), color]);
+  const result: EngineArrow[] = [];
+  sf.forEach((s, i) => {
+    const color = i ? engineColors.stockfishSecond : engineColors.stockfish;
+    const agreed = maia.get(s.uci);
+    result.push({ uci: s.uci, tail: [color], head: agreed ?? [color], width: agreed ? 25 : (s.width ?? 25) });
+    maia.delete(s.uci);
+  });
+  for (const [uci, colors] of maia) result.push({ uci, tail: colors, head: colors, width: 25 });
+  return result;
+}
+// One owned Chessground custom SVG per unique move. Agreement is painted once:
+// SF shaft + Maia head; two Maias share a split head (and split shaft without SF).
+// Chessground anchors a custom 100x100 SVG at the square corner (its outer
+// viewBox starts at -3.5). Translate to (50,50) before rotating around the center.
+export function engineShapes(arrows: EngineArrow[], orientation: Color): DrawShape[] {
+  return arrows.map(arrow => {
+    const { uci, tail, head, width } = arrow;
+    const sign = orientation === 'white' ? 1 : -1;
+    const dx = (uci.charCodeAt(2) - uci.charCodeAt(0)) * sign;
+    const dy = (Number(uci[1]) - Number(uci[3])) * sign;
+    const distance = Math.hypot(dx, dy) * 100;
+    const angle = (Math.atan2(dy, dx) * 180) / Math.PI;
+    const headHeight = 48 * Math.cos(Math.PI / 5);
+    const headHalf = 48 * Math.sin(Math.PI / 5);
+    const end = distance - headHeight;
+    const shaft =
+      tail.length === 1
+        ? `<path d="M33.333 0 H${end}" stroke="${tail[0]}" stroke-width="${width}"/>`
+        : tail
+            .map(
+              (color, i) =>
+                `<path d="M33.333 ${i ? width / 4 : -width / 4} H${end}" stroke="${color}" stroke-width="${width / 2 + 0.1}"/>`,
+            )
+            .join('');
+    const tip =
+      head.length === 1
+        ? `<path d="M${end} ${-headHalf} L${distance} 0 L${end} ${headHalf} Z" fill="${head[0]}"/>`
+        : `<path d="M${end} ${-headHalf} L${distance} 0 L${end} 0 Z" fill="${head[0]}"/><path d="M${end} 0 L${distance} 0 L${end} ${headHalf} Z" fill="${head[1]}"/>`;
+    return {
+      orig: uci.slice(0, 2) as Key,
+      dest: uci.slice(2, 4) as Key,
+      customSvg: {
+        html: `<g class="nosweat-engine-arrow" data-move="${uci}" data-tail="${tail.join(',')}" data-head="${head.join(',')}" transform="translate(50,50) rotate(${angle})" fill="none">${shaft}${tip}</g>`,
+      },
+    };
+  });
+}
diff --git a/ui/lib/src/nosweat/core.ts b/ui/lib/src/nosweat/core.ts
new file mode 100644
index 0000000..1a77e83
--- /dev/null
+++ b/ui/lib/src/nosweat/core.ts
@@ -0,0 +1,105 @@
+// Maia3 encoding/vocabulary: CSSLab 1e13597c and Mobile Maia; see provenance.
+import { Chess } from 'chessops/chess';
+import { makeFen, parseFen } from 'chessops/fen';
+import { makeSan } from 'chessops/san';
+import type { Move, NormalMove } from 'chessops/types';
+import { makeUci, parseUci } from 'chessops/util';
+import { normalizeMove } from 'chessops/variant';
+
+export const position = (fen: string): Chess => Chess.fromSetup(parseFen(fen).unwrap()).unwrap();
+export function legalMoves(pos: Chess): NormalMove[] {
+  const moves: NormalMove[] = [];
+  const ctx = pos.ctx();
+  for (const [from, tos] of pos.allDests(ctx))
+    for (const to of tos) {
+      const promotions =
+        pos.board.get(from)?.role === 'pawn' && (to < 8 || to >= 56)
+          ? (['queen', 'rook', 'bishop', 'knight'] as const)
+          : [undefined];
+      for (const promotion of promotions) moves.push({ from, to, promotion });
+    }
+  return moves;
+}
+export function standardUci(pos: Chess, move: Move): string {
+  // Chessops represents castling as king-to-rook; Maia and standard UCI use c/g.
+  if (
+    'from' in move &&
+    pos.board.get(move.from)?.role === 'king' &&
+    pos.board.get(move.to)?.color === pos.turn
+  ) {
+    return makeUci({ ...move, to: move.from + (move.to > move.from ? 2 : -2) });
+  }
+  return makeUci(move);
+}
+export const legalUcis = (fen: string): string[] => {
+  const pos = position(fen);
+  return legalMoves(pos).map(m => standardUci(pos, m));
+};
+export const san = (fen: string, uci: string): string => {
+  const pos = position(fen);
+  const move = parseUci(uci);
+  return move && pos.isLegal(move) ? makeSan(pos, move) : uci;
+};
+export function after(fen: string, uci: string): string {
+  const pos = position(fen);
+  const parsed = parseUci(uci);
+  if (!parsed || !pos.isLegal(parsed)) throw new Error('Illegal candidate');
+  pos.play(normalizeMove(pos, parsed));
+  return makeFen(pos.toSetup());
+}
+export function policyIndex(uci: string, black: boolean): number {
+  if (black) uci = uci[0] + (9 - Number(uci[1])) + uci[2] + (9 - Number(uci[3])) + uci.slice(4);
+  const square = (f: string, rank: string) => f.charCodeAt(0) - 97 + (Number(rank) - 1) * 8;
+  if (uci.length === 5)
+    return 4096 + (uci.charCodeAt(0) - 97) * 32 + (uci.charCodeAt(2) - 97) * 4 + 'qrbn'.indexOf(uci[4]);
+  return square(uci[0], uci[1]) * 64 + square(uci[2], uci[3]);
+}
+export interface Candidate {
+  uci: string;
+  probability: number;
+}
+// Shared summary for native analysis and puzzle review.
+export function leadingPolicy(fen: string, candidates: Candidate[]): string {
+  return candidates
+    .slice(0, 3)
+    .map(c => `${san(fen, c.uci)} ${(100 * c.probability).toFixed(1)}%`)
+    .join(' · ');
+}
+export function policy(fen: string, logits: Float32Array): Candidate[] {
+  if (logits.length !== 4352 || !logits.every(Number.isFinite)) throw new Error('Invalid Maia policy');
+  const black = position(fen).turn === 'black';
+  const moves = legalUcis(fen);
+  const values = moves.map(m => logits[policyIndex(m, black)]);
+  const max = Math.max(...values);
+  const weights = values.map(x => Math.exp(x - max));
+  const sum = weights.reduce((a, b) => a + b, 0);
+  return moves
+    .map((uci, i) => ({ uci, probability: weights[i] / sum }))
+    .sort((a, b) => b.probability - a.probability);
+}
+export function encodeHistory(history: string[], enabled: boolean): Float32Array {
+  const frames = enabled ? history.slice(-8) : history.slice(-1);
+  if (!frames.length) throw new Error('Missing position history');
+  while (frames.length < 8) frames.unshift(frames[0]);
+  const tokens = new Float32Array(64 * 97);
+  frames.forEach((fen, frame) => {
+    const pos = position(fen);
+    const black = pos.turn === 'black';
+    for (const [square, piece] of pos.board) {
+      const target = black ? square ^ 56 : square;
+      const role = ['pawn', 'knight', 'bishop', 'rook', 'queen', 'king'].indexOf(piece.role);
+      tokens[target * 97 + frame * 12 + role + (piece.color === pos.turn ? 0 : 6)] = 1;
+    }
+  });
+  return tokens;
+}
+export function scoreText(score?: EvalScore): string {
+  if (!score) return 'Unavailable';
+  if (score.mate !== undefined) return score.mate === 0 ? 'Checkmate' : `#${score.mate}`;
+  return score.cp === undefined ? 'Unavailable' : `${score.cp >= 0 ? '+' : ''}${(score.cp / 100).toFixed(2)}`;
+}
+export const terminalScore = (fen: string): EvalScore | undefined => {
+  const pos = position(fen);
+  if (!pos.isEnd()) return undefined;
+  return pos.isCheckmate() ? { mate: pos.turn === 'white' ? -1 : 1 } : { cp: 0 };
+};
diff --git a/ui/lib/src/nosweat/expectedScore.ts b/ui/lib/src/nosweat/expectedScore.ts
new file mode 100644
index 0000000..7a07f41
--- /dev/null
+++ b/ui/lib/src/nosweat/expectedScore.ts
@@ -0,0 +1,9 @@
+// Maia3 value head is [loss, draw, win], from the side-to-move perspective.
+// Same calculation as Mobile Maia's browser core.whiteScore, without the White flip.
+export function maiaExpectedScore(logits: ArrayLike<number>): number {
+  if (logits.length !== 3 || !Array.from(logits).every(Number.isFinite))
+    throw new Error('Invalid Maia value output');
+  const max = Math.max(...Array.from(logits));
+  const [loss, draw, win] = Array.from(logits, n => Math.exp(n - max));
+  return (win + draw / 2) / (loss + draw + win);
+}
