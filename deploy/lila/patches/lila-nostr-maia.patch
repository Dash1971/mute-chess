@@ -0,0 +1,320 @@
+import assert from 'node:assert/strict';
+import { describe, test } from 'node:test';
+
+import { gameAccuracy, moveAccuracy, whiteWinPercent } from '../src/noSweatAccuracy';
+import { maiaShapes, primaryArrowWidth } from '../src/noSweatArrows';
+import { ClassifierClient } from '../src/noSweatClassifierClient';
+import { classify, type ClassificationResult } from '../src/noSweatClassify';
+import { after } from '../src/noSweatCore';
+import type { Review } from '../src/noSweatFish';
+import { GameReview, gameReviewKey, reviewQualities, type ReviewNode } from '../src/noSweatGameReview';
+import { readEnginePreferences } from '../src/noSweatPreferences';
+import { reviewClick } from '../src/noSweatReviewView';
+const start = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1';
+const line = (): ReviewNode[] => {
+  const nodes: ReviewNode[] = [{ fen: start, path: '' }];
+  for (const [i, uci] of ['e2e4', 'e7e5', 'g1f3', 'b8c6'].entries())
+    nodes.push({ fen: after(nodes.at(-1)!.fen, uci), uci, path: 'x'.repeat(i + 1) });
+  return nodes;
+};
+const result = (overrides: Partial<ClassificationResult> = {}): ClassificationResult => ({
+  symbol: '',
+  accuracy: 100,
+  cpLoss: 0,
+  withheld: false,
+  version: 'test',
+  ...overrides,
+});
+const review = (depth = 12): Review => ({
+  current: {
+    depth,
+    lines: [
+      { cp: 20, moves: ['e2e4'] },
+      { cp: 0, moves: ['d2d4'] },
+    ],
+  },
+  previous: {
+    depth: depth - 1,
+    lines: [
+      { cp: 20, moves: ['e2e4'] },
+      { cp: 0, moves: ['d2d4'] },
+    ],
+  },
+});
+const near = (actual: number | null, expected: number) =>
+  assert.ok(actual !== null && Math.abs(actual - expected) < 1e-10, `${actual} != ${expected}`);
+describe('Mobile Maia whole-game review', () => {
+  test('review controls replace stale start, stop and navigation actions on redraw', () => {
+    let action = '';
+    const element = { onclick: undefined as (() => void) | undefined };
+    const vnode = { elm: element } as unknown as Parameters<
+      NonNullable<ReturnType<typeof reviewClick>['insert']>
+    >[0];
+    reviewClick(() => {
+      action = 'start';
+    }).insert!(vnode);
+    element.onclick!();
+    assert.equal(action, 'start');
+    reviewClick(() => {
+      action = 'stop';
+    }).update!(vnode, vnode);
+    element.onclick!();
+    assert.equal(action, 'stop');
+    reviewClick(() => {
+      action = 'g4';
+    }).update!(vnode, vnode);
+    element.onclick!();
+    assert.equal(action, 'g4');
+  });
+  test('accuracy matches independent Mobile Maia numeric references, including volatility windows and mates', () => {
+    const samples = [20, -40, -10, -180, -120, -260, -220, -500, -450].map(cp => ({ cp }));
+    const score = gameAccuracy(samples);
+    near(score.white, 56.109833517752875);
+    near(score.black, 86.48031060445908);
+    const long = gameAccuracy(Array.from({ length: 61 }, (_, i) => ({ cp: -300 + i * 10 })));
+    near(long.white, 100);
+    near(long.black, 97.2948770298707);
+    const mate = gameAccuracy([3, 2, 1, -1, -2].map(mate => ({ mate })));
+    near(mate.white, 2);
+    near(mate.black, 100);
+    const mobile = gameAccuracy([0, 0, 300, 300].map(cp => ({ cp })));
+    near(mobile.white, 100);
+    near(mobile.black, 32.39810425271999);
+    assert.equal(moveAccuracy(50, 50), 100);
+    assert.equal(moveAccuracy(40, 60), 100);
+    assert.deepEqual(gameAccuracy([]), { white: null, black: null });
+    assert.equal(gameAccuracy([{ cp: 0 }, { cp: -10 }], false).white, null);
+    near(gameAccuracy([{ cp: 0 }, { cp: -10 }], false).black, 100);
+    assert.throws(() => whiteWinPercent({}), /Missing/);
+  });
+  test('Maia arrows have the primary SF width even for very unlikely moves', () => {
+    const shapes = maiaShapes([
+      { uci: 'e2e4', probability: 0.99 },
+      { uci: 'd2d4', probability: 0.009 },
+      { uci: 'g1f3', probability: 0.001 },
+    ]);
+    assert.equal(primaryArrowWidth, 15);
+    assert.deepEqual(
+      shapes.map(s => s.modifiers?.lineWidth),
+      [15, 15, 15],
+    );
+  });
+  test('engine settings validate persisted input instead of trusting browser JSON', () => {
+    assert.equal(readEnginePreferences('{').selfElo, 1500);
+    assert.deepEqual(
+      readEnginePreferences(
+        JSON.stringify({
+          model: '79m',
+          quality: 'thorough',
+          selfElo: 2600,
+          opponentElo: 600,
+          history: false,
+          maiaArrows: false,
+        }),
+      ),
+      {
+        model: '79m',
+        quality: 'thorough',
+        selfElo: 2600,
+        opponentElo: 600,
+        history: false,
+        maiaArrows: false,
+        fishArrows: true,
+      },
+    );
+    const invalid = readEnginePreferences(
+      JSON.stringify({
+        model: 'remote',
+        quality: 'unbounded',
+        selfElo: 999999,
+        opponentElo: '1500',
+        history: 'false',
+      }),
+    );
+    assert.equal(invalid.model, '5m');
+    assert.equal(invalid.quality, 'fast');
+    assert.equal(invalid.selfElo, 1500);
+    assert.equal(invalid.history, true);
+  });
+  test('evaluates every position, publishes whole-game accuracy, then classifies every move', async () => {
+    const nodes = line();
+    const calls: string[] = [];
+    const phases: string[] = [];
+    const runner = new GameReview({
+      search: async (fen, _signal, depth, time) => {
+        assert.equal(depth, 12);
+        assert.equal(time, 500);
+        calls.push(fen);
+        return review();
+      },
+      classify: async input => {
+        assert.ok(runner.report?.accuracy);
+        assert.equal(input.reviews.length, input.positions.length);
+        return result();
+      },
+      changed: () => {
+        if (runner?.report) phases.push(runner.report.state);
+      },
+    });
+    await runner.start(nodes, 'fast');
+    assert.deepEqual(
+      calls,
+      nodes.map(n => n.fen),
+    );
+    assert.equal(runner.report?.state, 'complete');
+    assert.equal(runner.report?.moves.length, 4);
+    assert.ok(phases.includes('classifying'));
+    assert.equal(runner.running, false);
+    const original = runner.report;
+    runner.observe(
+      nodes.map(n => ({ ...n })),
+      'fast',
+    );
+    assert.equal(runner.report, original);
+    // Browsing to another path does not change the immutable game key.
+    assert.equal(gameReviewKey(nodes, 'fast'), gameReviewKey(nodes, 'fast'));
+    assert.notEqual(gameReviewKey(nodes, 'balanced'), gameReviewKey(nodes, 'fast'));
+  });
+  test('stop and a changed PGN prevent late searches from publishing stale results; resume reuses completed work', async () => {
+    const nodes = line();
+    let resolve!: (r: Review) => void;
+    let first = true;
+    const runner = new GameReview({
+      search: async () => {
+        if (first) {
+          first = false;
+          return new Promise<Review>(r => (resolve = r));
+        }
+        return review();
+      },
+      classify: async () => result(),
+      changed: () => {},
+    });
+    const pending = runner.start(nodes, 'fast');
+    runner.stop();
+    resolve(review());
+    await pending;
+    assert.equal(runner.report?.state, 'stopped');
+    assert.equal(runner.report?.reviews.length, 0);
+    await runner.start(nodes, 'fast');
+    assert.equal(runner.report?.state, 'complete');
+    runner.observe(nodes.slice(0, 2), 'fast');
+    assert.equal(runner.report, undefined);
+    assert.equal(runner.running, false);
+  });
+  test('an unfinished evaluation is never counted as a full-game accuracy score', async () => {
+    let count = 0;
+    const runner = new GameReview({
+      search: async () => {
+        if (++count === 3) throw new Error('engine unavailable');
+        return review();
+      },
+      classify: async () => result(),
+      changed: () => {},
+    });
+    await runner.start(line(), 'balanced');
+    assert.equal(runner.report?.state, 'failed');
+    assert.equal(runner.report?.accuracy, undefined);
+    assert.equal(runner.report?.reviews.length, 2);
+  });
+  test('classification failures retain accuracy and explicitly mark the affected moves unavailable', async () => {
+    const runner = new GameReview({
+      search: async () => review(),
+      classify: async () => {
+        throw new Error('worker stopped');
+      },
+      changed: () => {},
+    });
+    await runner.start(line(), 'thorough');
+    assert.equal(runner.report?.state, 'complete');
+    assert.ok(runner.report?.accuracy);
+    assert.deepEqual(runner.report?.unavailable, [1, 2, 3, 4]);
+  });
+  test('standout confirmation has a six-search budget and leaves baseline graph scores unchanged', async () => {
+    let confirmations = 0;
+    const runner = new GameReview({
+      search: async (_fen, _signal, depth, time) => {
+        assert.equal(time, 500);
+        if (depth === 14) confirmations++;
+        return review(depth);
+      },
+      classify: async input =>
+        input.confirmation ? result({ symbol: '!!' }) : result({ withheld: true, provisional: '!!' }),
+      changed: () => {},
+    });
+    await runner.start(line(), 'fast');
+    assert.ok(confirmations <= 6);
+    assert.ok(confirmations > 0);
+    assert.ok(runner.report?.reviews.every(r => r.current.depth === 12));
+    assert.equal(runner.report?.state, 'complete');
+    assert.deepEqual(reviewQualities, {
+      fast: { name: 'Fast', depth: 12, time: 500 },
+      balanced: { name: 'Balanced', depth: 14, time: 1000 },
+      thorough: { name: 'Thorough', depth: 16, time: 1500 },
+    });
+  });
+  test('explicit whole-window confirmation can veto an apparently stable standout', () => {
+    const before = {
+      depth: 12,
+      lines: [
+        { cp: 200, moves: ['e2e4'] },
+        { cp: -500, moves: ['d2d4'] },
+      ],
+    };
+    const next = { depth: 12, lines: [{ cp: 200, moves: ['e7e5'] }] };
+    const reviews: Review[] = [
+      { current: before, previous: before, quality: 'fast' },
+      { current: next, previous: next, quality: 'fast' },
+    ];
+    const base = { positions: [start, after(start, 'e2e4')], reviews, move: 'e2e4' };
+    assert.equal(classify(base).symbol, '!');
+    assert.equal(
+      classify({
+        ...base,
+        confirmation: [
+          reviews[0],
+          { ...reviews[1], current: { depth: 14, lines: [{ cp: -600, moves: ['e7e5'] }] } },
+        ],
+      }).symbol,
+      '',
+    );
+    assert.equal(
+      classify({ ...base, confirmation: reviews.map(r => ({ ...r, quality: 'thorough' })) }).withheld,
+      true,
+    );
+  });
+  test('classifier ownership rejects cancellation and isolates a stale worker from the next job', async () => {
+    class FakeWorker {
+      onmessage: any;
+      onerror: any;
+      terminated = false;
+      postMessage() {}
+      terminate() {
+        this.terminated = true;
+      }
+    }
+    const workers: FakeWorker[] = [];
+    const client = new ClassifierClient(() => {
+      const w = new FakeWorker();
+      workers.push(w);
+      return w as unknown as Worker;
+    });
+    const signal = new AbortController();
+    const first = client
+      .classify({ positions: [], reviews: [], move: '' }, signal.signal)
+      .catch(e => e.message);
+    const stale = workers[0].onmessage;
+    signal.abort();
+    assert.equal(await first, 'Cancelled');
+    assert.equal(workers[0].terminated, true);
+    const second = client.classify({ positions: [], reviews: [], move: '' }, new AbortController().signal);
+    stale({ data: { result: result({ symbol: '??' }) } });
+    workers[1].onmessage({ data: { result: result({ symbol: '!' }) } });
+    assert.equal((await second).symbol, '!');
+    const third = client.classify({ positions: [], reviews: [], move: '' }, new AbortController().signal);
+    workers[1].onmessage({ data: { result: result() } });
+    await third;
+    assert.equal(workers.length, 2);
+    client.release();
+  });
+});
diff --git a/ui/round/src/premoveSequence.ts b/ui/round/src/premoveSequence.ts
new file mode 100644
index 0000000..249bf9a
--- /dev/null
+++ b/ui/round/src/premoveSequence.ts
@@ -0,0 +1,92 @@
+// Adapted from Mobile Maia PremoveSequence (AGPL-3.0), see extension provenance.
+// A visual plan only. Server-provided destinations authorize every execution.
+import { read, write } from '@lichess-org/chessground/fen';
+import type { Color, Key, Pieces, Role } from '@lichess-org/chessground/types';
+
+export interface QueuedMove {
+  orig: Key;
+  dest: Key;
+  promotion?: Role;
+}
+
+export class PremoveSequence {
+  readonly moves: QueuedMove[] = [];
+  generation = 0;
+  clear(): void {
+    this.moves.length = 0;
+    this.generation++;
+  }
+  add(fen: string, color: Color, move: QueuedMove): boolean {
+    if (this.moves.length >= 64) return false;
+    const piece = read(this.project(fen, color)).get(move.orig);
+    if (piece?.color !== color) return false;
+    if (piece.role === 'king' && move.orig.startsWith('e') && move.orig[1] === move.dest[1]) {
+      if (move.dest.startsWith('h')) move = { ...move, dest: ('g' + move.orig[1]) as Key };
+      if (move.dest.startsWith('a')) move = { ...move, dest: ('c' + move.orig[1]) as Key };
+    }
+    if (piece.role === 'pawn' && ['1', '8'].includes(move.dest[1]))
+      move = { ...move, promotion: move.promotion ?? 'queen' };
+    this.moves.push(move);
+    return true;
+  }
+  // Do not use this projection for legality, clocks, material or persistence.
+  project(fen: string, color: Color): string {
+    const pieces: Pieces = read(fen);
+    for (const move of this.moves) {
+      const piece = pieces.get(move.orig);
+      if (piece?.color !== color) continue;
+      if (
+        piece.role === 'king' &&
+        move.orig.startsWith('e') &&
+        move.orig[1] === move.dest[1] &&
+        ['c', 'g'].includes(move.dest[0])
+      ) {
+        const rookFrom = ((move.dest.startsWith('c') ? 'a' : 'h') + move.orig[1]) as Key;
+        const rookTo = ((move.dest.startsWith('c') ? 'd' : 'f') + move.orig[1]) as Key;
+        const rook = pieces.get(rookFrom);
+        if (rook?.role === 'rook' && rook.color === color) {
+          pieces.delete(rookFrom);
+          pieces.set(rookTo, rook);
+        }
+      }
+      if (piece.role === 'pawn' && !move.dest.startsWith(move.orig[0]) && !pieces.has(move.dest)) {
+        const captured = (move.dest[0] + move.orig[1]) as Key;
+        const enemy = pieces.get(captured);
+        if (enemy?.role === 'pawn' && enemy.color !== color) pieces.delete(captured);
+      }
+      pieces.delete(move.orig);
+      pieces.set(move.dest, { ...piece, role: move.promotion ?? piece.role });
+    }
+    return write(pieces);
+  }
+  get destinations(): Map<Key, boolean> {
+    const squares = new Map<Key, boolean>();
+    for (const move of this.moves) {
+      squares.set(move.orig, false);
+      squares.set(move.dest, true);
+    }
+    return squares;
+  }
+  take(fen: string, color: Color, dests: Map<Key, Key[]>): QueuedMove | undefined {
+    const move = this.moves.shift();
+    if (!move) return undefined;
+    const piece = read(fen).get(move.orig);
+    const allowed = dests.get(move.orig) ?? [];
+    const castleRook =
+      piece?.role === 'king' &&
+      move.orig.startsWith('e') &&
+      ['c', 'g'].includes(move.dest[0]) &&
+      move.orig[1] === move.dest[1]
+        ? (((move.dest.startsWith('c') ? 'a' : 'h') + move.orig[1]) as Key)
+        : undefined;
+    if (
+      piece?.color !== color ||
+      (!allowed.includes(move.dest) && !(castleRook && allowed.includes(castleRook))) ||
+      (move.promotion && (piece.role !== 'pawn' || !['1', '8'].includes(move.dest[1])))
+    ) {
+      this.clear();
+      return undefined;
+    }
+    return move;
+  }
+}
diff --git a/ui/round/tests/premoveSequence.test.ts b/ui/round/tests/premoveSequence.test.ts
new file mode 100644
index 0000000..9fc8e4d
--- /dev/null
+++ b/ui/round/tests/premoveSequence.test.ts
@@ -0,0 +1,95 @@
+import { read } from '@lichess-org/chessground/fen';
+import assert from 'node:assert/strict';
+import { describe, test } from 'node:test';
+
+import { PremoveSequence } from '../src/premoveSequence';
+
+const start = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR';
+describe('Mobile Maia stacked premoves', () => {
+  test('same piece can move repeatedly on the projected board; original is unchanged', () => {
+    const q = new PremoveSequence();
+    assert.equal(q.add(start, 'white', { orig: 'e2', dest: 'e4' }), true);
+    assert.equal(q.add(start, 'white', { orig: 'e4', dest: 'e5' }), true);
+    assert.equal(read(q.project(start, 'white')).get('e5')?.role, 'pawn');
+    assert.equal(read(start).get('e2')?.role, 'pawn');
+    assert.equal(q.take(start, 'white', new Map([['e2', ['e3', 'e4']]]))?.dest, 'e4');
+    assert.equal(q.moves.length, 1);
+  });
+  test('illegal head clears the complete plan, even if a later move is legal', () => {
+    const q = new PremoveSequence();
+    q.add(start, 'white', { orig: 'e2', dest: 'e4' });
+    q.add(start, 'white', { orig: 'g1', dest: 'f3' });
+    assert.equal(q.take(start, 'white', new Map([['g1', ['f3']]])), undefined);
+    assert.equal(q.moves.length, 0);
+  });
+  test('capture of the planned piece invalidates the queue', () => {
+    const q = new PremoveSequence();
+    q.add(start, 'white', { orig: 'e2', dest: 'e4' });
+    assert.equal(
+      q.take(start.replace('PPPPPPPP', 'PPPPpPPP'), 'white', new Map([['e2', ['e4']]])),
+      undefined,
+    );
+  });
+  test('king-to-rook castling normalizes and projects both pieces', () => {
+    const fen = '4k3/8/8/8/8/8/8/R3K2R';
+    const q = new PremoveSequence();
+    q.add(fen, 'white', { orig: 'e1', dest: 'h1' });
+    const projected = read(q.project(fen, 'white'));
+    assert.equal(projected.get('g1')?.role, 'king');
+    assert.equal(projected.get('f1')?.role, 'rook');
+    assert.equal(q.take(fen, 'white', new Map([['e1', ['h1']]]))?.dest, 'g1');
+  });
+  test('en passant projection removes only the opposing pawn; authoritative dests decide execution', () => {
+    const fen = '4k3/8/8/3pP3/8/8/8/4K3';
+    const q = new PremoveSequence();
+    q.add(fen, 'white', { orig: 'e5', dest: 'd6' });
+    const projected = read(q.project(fen, 'white'));
+    assert.equal(projected.has('d5'), false);
+    assert.equal(projected.get('d6')?.role, 'pawn');
+    assert.equal(q.take(fen, 'white', new Map([['e5', ['e6']]])), undefined);
+  });
+  test('underpromotion is retained for a later move of the promoted piece', () => {
+    const fen = '4k3/P7/8/8/8/8/8/4K3';
+    const q = new PremoveSequence();
+    q.add(fen, 'white', { orig: 'a7', dest: 'a8', promotion: 'knight' });
+    q.add(fen, 'white', { orig: 'a8', dest: 'b6' });
+    assert.equal(read(q.project(fen, 'white')).get('b6')?.role, 'knight');
+    assert.equal(q.take(fen, 'white', new Map([['a7', ['a8']]]))?.promotion, 'knight');
+  });
+  test('black castling, capture projection and promotion work without orientation assumptions', () => {
+    const q = new PremoveSequence();
+    const fen = 'r3k2r/8/8/8/8/8/1p6/R3K3';
+    q.add(fen, 'black', { orig: 'e8', dest: 'a8' });
+    q.add(fen, 'black', { orig: 'b2', dest: 'a1', promotion: 'rook' });
+    const p = read(q.project(fen, 'black'));
+    assert.equal(p.get('c8')?.role, 'king');
+    assert.equal(p.get('d8')?.role, 'rook');
+    assert.deepEqual(p.get('a1'), { role: 'rook', color: 'black' });
+  });
+  test('cancellation invalidates scheduled execution generations; queue length is bounded', () => {
+    const q = new PremoveSequence();
+    for (let i = 0; i < 32; i++) {
+      q.add(start, 'white', { orig: 'g1', dest: 'f3' });
+      q.add(start, 'white', { orig: 'f3', dest: 'g1' });
+    }
+    assert.equal(q.moves.length, 64);
+    assert.equal(q.add(start, 'white', { orig: 'e2', dest: 'e4' }), false);
+    const generation = q.generation;
+    q.clear();
+    assert.ok(q.generation > generation);
+    assert.equal(q.take(start, 'white', new Map([['e2', ['e4']]])), undefined);
+  });
+  test('Mobile Maia square tints keep only the last use of an intermediate square', () => {
+    const q = new PremoveSequence();
+    q.add(start, 'white', { orig: 'g1', dest: 'f3' });
+    q.add(start, 'white', { orig: 'f3', dest: 'g5' });
+    assert.deepEqual(
+      [...q.destinations],
+      [
+        ['g1', false],
+        ['f3', false],
+        ['g5', true],
+      ],
+    );
+  });
+});
