+import { url } from 'lib/xhr';
+
+import type AnalyseCtrl from './ctrl';
+import { boardPgn } from './noSweatPgn';
+
+// Unsaved lines have no game ID. Reuse native position routes and pure-PGN GIF
+// rendering instead of inventing a saved-game URL or persisting an import.
+export function positionImageUrl(ctrl: AnalyseCtrl): string {
+  const ds = document.body.dataset;
+  return url(`${window.location.origin}/export/fen.gif`, {
+    fen: ctrl.node.fen,
+    color: ctrl.bottomColor(),
+    lastMove: ctrl.node.uci,
+    variant: 'standard',
+    theme: ds.board,
+    piece: ds.pieceSet,
+  });
+}
+
+export function positionShareUrl(ctrl: AnalyseCtrl, embed = false): string {
+  return url(`${window.location.origin}/${embed ? 'embed/analysis' : 'analysis/standard'}`, {
+    fen: ctrl.node.fen,
+    color: ctrl.bottomColor(),
+    ...(embed && { theme: 'auto', bg: 'auto' }),
+  });
+}
+
+export function analysisGifUrl(
+  ctrl: AnalyseCtrl,
+  orientation: Color,
+  prefs: Record<string, boolean>,
+): string {
+  return url('/analysis/export.gif', {
+    pgn: boardPgn(ctrl, 'raw'),
+    color: orientation,
+    theme: document.body.dataset.board,
+    piece: document.body.dataset.pieceSet,
+    ...prefs,
+    glyphs: false,
+  });
+}
+
+export function canExportAnalysisGif(ctrl: AnalyseCtrl): boolean {
+  return ctrl.mainline.length >= 2 && ctrl.mainline.length <= 601 && boardPgn(ctrl, 'raw').length <= 5000;
+}
diff --git a/ui/analyse/src/noSweatFish.ts b/ui/analyse/src/noSweatFish.ts
new file mode 100644
index 0000000..b703dec
--- /dev/null
+++ b/ui/analyse/src/noSweatFish.ts
@@ -0,0 +1,228 @@
+import type { BrowserEngineInfo } from 'lib/ceval';
+// Use Lila's native Stockfish loader/assets with a separate bounded review queue.
+import { StockfishWebEngine } from 'lib/ceval/engines/stockfishWebEngine';
+import { Protocol } from 'lib/ceval/protocol';
+
+import { legalUcis, position, terminalScore } from './noSweatCore';
+import { SearchSnapshots, type Snapshot } from './noSweatSnapshots';
+
+export interface Review {
+  current: Snapshot;
+  previous?: Snapshot;
+  terminal?: boolean;
+  quality?: string;
+}
+const info: BrowserEngineInfo = {
+  id: 'nosweat-review-sf19-small',
+  name: 'Stockfish 19 · 1MB',
+  tech: 'NNUE',
+  short: 'SF19',
+  minThreads: 1,
+  maxThreads: 1,
+  minMem: 1536,
+  requires: ['sharedMem', 'simd', 'dynamicImportFromWorker'],
+  assets: { root: 'npm/stockfish-web', js: 'sf_19_smallnet.js' },
+};
+class ReviewProtocol extends Protocol {
+  private output?: (command: string) => void;
+  private session?: symbol;
+  private task?: {
+    fen: string;
+    moves: string[];
+    depth: number;
+    time: number;
+    snapshots: SearchSnapshots;
+    resolve: (r: Review) => void;
+    reject: (e: Error) => void;
+    signal: AbortSignal;
+    started: boolean;
+    timer: ReturnType<typeof setTimeout>;
+  };
+  private booted!: () => void;
+  private bootFailure!: (e: Error) => void;
+  readonly boot: Promise<void>;
+  constructor(engineInfo: BrowserEngineInfo) {
+    super(engineInfo);
+    this.boot = new Promise((resolve, reject) => {
+      this.booted = resolve;
+      this.bootFailure = reject;
+    });
+    this.boot.catch(() => {});
+  }
+  override connected(send: (command: string) => void): void {
+    this.output = send;
+    send('uci');
+  }
+  override isComputing(): boolean {
+    return !!this.task;
+  }
+  override received(text: string): void {
+    if (text === 'uciok') {
+      for (const cmd of [
+        'setoption name Threads value 1',
+        'setoption name Hash value 16',
+        'setoption name UCI_Chess960 value false',
+        'setoption name UCI_AnalyseMode value true',
+        'isready',
+      ])
+        this.output?.(cmd);
+    } else if (text === 'readyok') {
+      this.booted();
+      const t = this.task;
+      if (t && !t.started) {
+        t.started = true;
+        this.output?.('position fen ' + t.fen);
+        this.output?.(
+          `go depth ${t.depth} movetime ${t.time}` +
+            (t.moves.length ? ' searchmoves ' + t.moves.join(' ') : ''),
+        );
+      }
+    } else if (text.startsWith('info ')) this.task?.snapshots.add(text);
+    else if (text.startsWith('bestmove')) {
+      const t = this.task;
+      if (!t) return;
+      clearTimeout(t.timer);
+      this.task = undefined;
+      if (t.signal.aborted) t.reject(new Error('Cancelled'));
+      else if (t.snapshots.completed)
+        t.resolve({ current: t.snapshots.completed, previous: t.snapshots.previous });
+      else t.reject(new Error('Stockfish did not finish a complete MultiPV iteration'));
+    }
+  }
+  fail(error: Error): void {
+    this.bootFailure(error);
+    const t = this.task;
+    this.task = undefined;
+    if (t) {
+      clearTimeout(t.timer);
+      t.reject(error);
+    }
+  }
+  async search(
+    fen: string,
+    moves: string[],
+    depth: number,
+    time: number,
+    signal: AbortSignal,
+    session?: symbol,
+    multiPv = 2,
+  ): Promise<Review> {
+    let deadline: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await Promise.race([
+        this.boot,
+        new Promise<never>((_, reject) => {
+          deadline = setTimeout(() => reject(new Error('Stockfish startup timed out')), 45000);
+        }),
+      ]);
+    } finally {
+      clearTimeout(deadline);
+    }
+    if (signal.aborted) throw new Error('Cancelled');
+    const terminal = terminalScore(fen);
+    if (terminal) return { current: { depth: 99, lines: [{ ...terminal, moves: [] }] }, terminal: true };
+    const legal = new Set(moves.length ? moves : legalUcis(fen));
+    const count = Math.min(
+      legal.size,
+      Number.isFinite(multiPv) ? Math.max(1, Math.min(3, Math.floor(multiPv))) : 2,
+    );
+    return new Promise((resolve, reject) => {
+      if (this.task) {
+        reject(new Error('Review queue busy'));
+        return;
+      }
+      const t = (this.task = {
+        fen,
+        moves,
+        depth,
+        time,
+        resolve,
+        reject,
+        signal,
+        started: false,
+        snapshots: new SearchSnapshots(legal, count, position(fen).turn === 'white'),
+        timer: setTimeout(() => this.fail(new Error('Stockfish review timed out')), time + 15000),
+      });
+      signal.addEventListener(
+        'abort',
+        () => {
+          if (this.task === t) {
+            if (t.started) this.output?.('stop');
+            else {
+              clearTimeout(t.timer);
+              this.task = undefined;
+              reject(new Error('Cancelled'));
+            }
+          }
+        },
+        { once: true },
+      );
+      if (!session || session !== this.session) {
+        this.output?.('ucinewgame');
+        this.output?.('setoption name Clear Hash');
+      }
+      this.session = session;
+      this.output?.('setoption name MultiPV value ' + count);
+      this.output?.('isready');
+    });
+  }
+}
+class OwnedReviewEngine extends StockfishWebEngine {
+  private disposed = false;
+  override async boot(): Promise<void> {
+    await super.boot();
+    if (this.disposed) this.destroy();
+  }
+  override destroy = (): void => {
+    this.disposed = true;
+    this.module?.uci('quit');
+    this.module = undefined;
+  };
+}
+export class ReviewFish {
+  private protocol?: ReviewProtocol;
+  private engine?: StockfishWebEngine;
+  private tail: Promise<unknown> = Promise.resolve();
+  private generation = 0;
+  constructor(
+    private readonly status: (s: string) => void,
+    private readonly engineInfo: BrowserEngineInfo = info,
+  ) {}
+  search(
+    fen: string,
+    moves: string[],
+    signal: AbortSignal,
+    depth = 14,
+    time = 1200,
+    session?: symbol,
+    multiPv = 2,
+  ): Promise<Review> {
+    const generation = this.generation;
+    const job = this.tail
+      .catch(() => {})
+      .then(async () => {
+        if (signal.aborted || generation !== this.generation) throw new Error('Cancelled');
+        if (!this.protocol) {
+          const protocol = (this.protocol = new ReviewProtocol(this.engineInfo));
+          this.engine = new OwnedReviewEngine(
+            { ...this.engineInfo, assets: { ...this.engineInfo.assets } },
+            s => {
+              if (s?.error) protocol.fail(new Error(s.error));
+              else if (s?.download) this.status('Loading Stockfish review…');
+            },
+            protocol,
+          );
+        }
+        return this.protocol.search(fen, moves, depth, time, signal, session, multiPv);
+      });
+    this.tail = job;
+    return job;
+  }
+  destroy(): void {
+    this.generation++;
+    this.protocol?.fail(new Error('Cancelled'));
+    this.engine?.destroy();
+    this.engine = undefined;
+    this.protocol = undefined;
+  }
+}
diff --git a/ui/analyse/src/noSweatFullReview.ts b/ui/analyse/src/noSweatFullReview.ts
new file mode 100644
index 0000000..18c2480
--- /dev/null
+++ b/ui/analyse/src/noSweatFullReview.ts
@@ -0,0 +1,144 @@
+// Mobile Maia / En Croissant annotations over native Lichess analysis.
+// Accuracy, ACPL, best lines and Learn from your mistakes stay native.
+import { parseUci } from 'chessops/util';
+
+import { gameReviewQualities } from 'lib/nosweat/reviewQuality';
+import type { Glyph, TreeNodeBase } from 'lib/tree/types';
+
+import { type Annotation, type ClassificationInput, type ClassificationResult } from './noSweatClassify';
+import { legalUcis, position, standardUci, terminalScore } from './noSweatCore';
+import type { Review } from './noSweatFish';
+
+export const reviewSource = 'mobile-maia-full-review-v2';
+export const moveClasses = [
+  { symbol: '!!', id: 3, name: 'Brilliant', color: '#15aabf' },
+  { symbol: '!', id: 1, name: 'Good', color: '#12b886' },
+  { symbol: '!?', id: 5, name: 'Interesting', color: '#82c91e' },
+  { symbol: '?!', id: 6, name: 'Dubious', color: '#fab005' },
+  { symbol: '?', id: 2, name: 'Mistake', color: '#fd7e14' },
+  { symbol: '??', id: 4, name: 'Blunder', color: '#fa5252' },
+] as const;
+export const qualityGlyph = (symbol: Annotation): Glyph | undefined => {
+  const c = moveClasses.find(c => c.symbol === symbol);
+  return c && { id: c.id, name: c.name, symbol, comp: true, source: reviewSource };
+};
+
+export { gameReviewQualities, gameReviewQuality } from 'lib/nosweat/reviewQuality';
+
+export function nativeReview(node: TreeNodeBase): Review | undefined {
+  const terminal = terminalScore(node.fen);
+  if (terminal)
+    return {
+      current: { depth: 99, lines: [{ ...terminal, moves: [] }] },
+      terminal: true,
+      quality: reviewSource,
+    };
+  const evals = node.eval?.pvs;
+  if (!evals || evals.length < Math.min(2, legalUcis(node.fen).length)) return undefined;
+  const pos = position(node.fen);
+  const lines = evals.slice(0, 2).map(pv => ({
+    ...pv,
+    moves: pv.moves.split(' ').map((uci, i) => {
+      const move = parseUci(uci);
+      return i === 0 && move ? standardUci(pos, move) : uci;
+    }),
+  }));
+  if (new Set(lines.map(l => l.moves[0])).size !== lines.length) return undefined;
+  return { current: { depth: node.eval?.depth ?? 0, lines }, quality: reviewSource };
+}
+
+interface Dependencies {
+  classify(input: ClassificationInput, signal: AbortSignal): Promise<ClassificationResult>;
+  search(fen: string, signal: AbortSignal, depth: number, time: number, session?: symbol): Promise<Review>;
+}
+export class FullGameClassifier {
+  constructor(private readonly deps: Dependencies) {}
+  async run(
+    nodes: TreeNodeBase[],
+    signal: AbortSignal,
+    current: () => boolean,
+    progress: (done: number, total: number, phase?: string) => void,
+    quality: { depth: number; movetime: number } = gameReviewQualities[0],
+  ): Promise<Map<number, Annotation>> {
+    const valid = () => {
+      if (signal.aborted || !current()) throw new Error('Cancelled');
+    };
+    const results = new Map<number, Annotation>();
+    if (!nodes.slice(1).some(n => n.uci && !n.glyphs?.some(g => !g.comp && g.id >= 1 && g.id <= 6)))
+      return results;
+    // Mobile Maia reviews the line forwards in one isolated engine session.
+    // Native replay evaluates backwards and does not retain earlier complete
+    // iterations. Keep its graph/accuracy untouched, and collect the complete
+    // classification evidence separately instead of silently dropping it.
+    const session = Symbol();
+    const reviews: Review[] = [];
+    for (const [i, node] of nodes.entries()) {
+      valid();
+      progress(i, nodes.length - 1, 'Checking move evidence');
+      reviews.push({
+        ...(await this.deps.search(node.fen, signal, quality.depth, quality.movetime, session)),
+        quality: `${reviewSource}:${quality.depth}:${quality.movetime}`,
+      });
+      valid();
+    }
+    let confirmationBudget = 6;
+    for (let i = 1; i < nodes.length; i++) {
+      valid();
+      progress(i - 1, nodes.length - 1);
+      if (!nodes[i].uci || nodes[i].glyphs?.some(g => !g.comp && g.id >= 1 && g.id <= 6)) continue;
+      const window = nodes.slice(Math.max(0, i - 2), i + 1);
+      const windowReviews = reviews.slice(Math.max(0, i - 2), i + 1);
+      const before = window[window.length - 2];
+      const move = parseUci(nodes[i].uci!);
+      if (!move) continue;
+      const input = {
+        positions: window.map(n => n.fen),
+        reviews: windowReviews,
+        move: standardUci(position(before.fen), move),
+      };
+      let result = await this.deps.classify(input, signal);
+      valid();
+      const provisional = result.provisional ?? result.symbol;
+      // A complete earlier-iteration window is already corroboration. Only an
+      // unsupported award consumes Mobile Maia's six-search check allowance.
+      if ((provisional === '!!' || provisional === '!') && result.withheld) {
+        const start = provisional === '!' && i > 1 ? i - 2 : i - 1;
+        const cost = i - start + 1;
+        if (cost > confirmationBudget) continue;
+        confirmationBudget -= cost;
+        const confirmation: Review[] = [];
+        const confirmationSession = Symbol();
+        for (let n = start; n <= i; n++) {
+          valid();
+          confirmation.push({
+            ...(await this.deps.search(
+              nodes[n].fen,
+              signal,
+              quality.depth + 2,
+              quality.movetime,
+              confirmationSession,
+            )),
+            quality: reviews[n].quality,
+          });
+          valid();
+        }
+        result = await this.deps.classify({ ...input, confirmation }, signal);
+        valid();
+      }
+      if (!result.withheld) results.set(nodes[i].ply, result.symbol);
+    }
+    valid();
+    progress(nodes.length - 1, nodes.length - 1);
+    return results;
+  }
+}
+
+export function classificationCounts(nodes: TreeNodeBase[], color: Color): number[] {
+  const counts = moveClasses.map(() => 0);
+  for (const node of nodes) {
+    if (!node.uci || (node.ply % 2 === 1 ? 'white' : 'black') !== color) continue;
+    const category = moveClasses.findIndex(c => node.glyphs?.some(g => g.id === c.id));
+    if (category !== -1) counts[category]++;
+  }
+  return counts;
+}
