+
+test('compact channels preserve raw probabilities and independently expand all legal moves', () => {
+  const patch = init([attributesModule]);
+  const host = document.createElement('div');
+  document.body.append(host);
+  let vnode: VNode | Element = host;
+  const expanded = [false, false];
+  const played: string[] = [];
+  const render = () => {
+    vnode = patch(
+      vnode,
+      hl(
+        'section',
+        [primary, [...primary].reverse()].map((candidates, i) =>
+          puzzleMaiaChannel({
+            id: `maia-${i}`,
+            fen,
+            rating: i ? 2600 : 1600,
+            candidates,
+            color: 'orange',
+            status: '',
+            expanded: expanded[i],
+            toggle: () => {
+              expanded[i] = !expanded[i];
+              render();
+            },
+            play: uci => played.push(uci),
+          }),
+        ),
+      ),
+    );
+  };
+  render();
+  const root = () => vnode.elm as HTMLElement;
+  const other = (index: number) => root().querySelectorAll<HTMLButtonElement>('.nosweat-maia-other')[index];
+  const panels = () => [...root().querySelectorAll<HTMLElement>('.nosweat-puzzle-policy')];
+  assert.equal(other(0).textContent, 'Other 28.8%');
+  assert.equal(other(1).textContent, 'Other 66.4%');
+  assert.equal(root().querySelector('.nosweat-maia-probability')!.textContent, '49.2%');
+  assert.equal(root().querySelectorAll('.nosweat-maia-move').length, 6);
+  assert.ok(!root().textContent.includes('·'));
+  assert.ok(panels().every(panel => panel.hidden));
+  other(0).click();
+  assert.equal(other(0).getAttribute('aria-expanded'), 'true');
+  assert.equal(other(0).getAttribute('aria-controls'), panels()[0].id);
+  assert.deepEqual(
+    panels().map(panel => panel.hidden),
+    [false, true],
+  );
+  assert.equal(panels()[0].querySelectorAll('tbody tr').length, primary.length);
+  assert.equal(panels()[0].querySelector('tbody tr:last-child td:last-child')!.textContent, '<0.1%');
+  panels()[0].querySelector<HTMLButtonElement>('tbody tr:last-child button')!.click();
+  assert.deepEqual(played, ['b1c3']);
+  other(0).click();
+  other(0).click();
+  other(1).click();
+  assert.deepEqual(
+    panels().map(panel => panel.hidden),
+    [false, false],
+  );
+  other(0).click();
+  assert.deepEqual(
+    panels().map(panel => panel.hidden),
+    [true, false],
+  );
+  root().remove();
+});
+
+test('pending and terminal channels have no misleading Other control', () => {
+  const patch = init([attributesModule]);
+  for (const status of ['Analyzing…', 'No legal moves']) {
+    const host = document.createElement('div');
+    document.body.append(host);
+    const vnode = patch(
+      host,
+      puzzleMaiaChannel({
+        id: 'empty',
+        fen,
+        rating: 1600,
+        candidates: [],
+        color: 'orange',
+        status,
+        expanded: true,
+        toggle: () => assert.fail('empty channel cannot expand'),
+        play: () => {},
+      }),
+    );
+    const root = vnode.elm as HTMLElement;
+    assert.equal(root.querySelector('.nosweat-maia-status')!.textContent, status);
+    assert.equal(root.querySelector('.nosweat-maia-other'), null);
+    assert.ok(root.querySelector<HTMLElement>('.nosweat-puzzle-policy')!.hidden);
+    root.remove();
+  }
+});
+
+test('puzzle Maia labels are keyboard-accessible rating buttons for their own channel', () => {
+  const chosen: number[] = [];
+  const host = document.createElement('div');
+  document.body.append(host);
+  const vnode = init([attributesModule])(
+    host,
+    hl(
+      'section',
+      [1600, 2600].map((rating, i) =>
+        puzzleMaiaChannel({
+          id: `rating-${i}`,
+          fen,
+          rating,
+          candidates: primary,
+          color: 'orange',
+          status: '',
+          expanded: false,
+          toggle: () => {},
+          play: () => {},
+          chooseRating: () => chosen.push(rating),
+        }),
+      ),
+    ),
+  );
+  const root = vnode.elm as HTMLElement;
+  const labels = root.querySelectorAll<HTMLButtonElement>('button.nosweat-maia-label');
+  assert.equal(labels.length, 2);
+  assert.equal(labels[0].getAttribute('aria-haspopup'), 'dialog');
+  labels[0].click();
+  labels[1].click();
+  assert.deepEqual(chosen, [1600, 2600]);
+  root.remove();
+});
+
+test('puzzle review drops only the second row and still withholds all Maia UI while solving', () => {
+  const ctrl = {
+    mode: 'view',
+    cevalEnabled: () => true,
+    threatMode: () => false,
+    node: { fen, outcome: () => undefined },
+    data: { puzzle: { id: 'test' } },
+    setAutoShapes: () => {},
+    redraw: () => {},
+  } as unknown as PuzzleCtrl;
+  const maia = new PuzzleMaia(ctrl);
+  saveEnginePreferences({ ...defaultEnginePreferences });
+  const host = document.createElement('div');
+  document.body.append(host);
+  const patch = init([attributesModule]);
+  let vnode = patch(host, maia.view()!);
+  assert.equal((vnode.elm as HTMLElement).querySelectorAll('.nosweat-maia-channel').length, 2);
+  saveEnginePreferences({ ...defaultEnginePreferences, secondMaiaEnabled: false });
+  vnode = patch(vnode, maia.view()!);
+  assert.equal((vnode.elm as HTMLElement).querySelectorAll('.nosweat-maia-channel').length, 1);
+  assert.equal((vnode.elm as HTMLElement).querySelector('.nosweat-maia-label')!.textContent, 'M1500');
+  saveEnginePreferences({ ...defaultEnginePreferences, maiaArrows: false });
+  vnode = patch(vnode, maia.view()!);
+  assert.ok(
+    (vnode.elm as HTMLElement).querySelector('.nosweat-maia-settings'),
+    'settings remain reachable with arrows off',
+  );
+  assert.equal((vnode.elm as HTMLElement).querySelectorAll('.nosweat-maia-channel').length, 2);
+  ctrl.mode = 'play';
+  assert.equal(maia.view(), undefined);
+  maia.cancel();
+  (vnode.elm as HTMLElement).remove();
+});
diff --git a/ui/round/src/premoveSequence.ts b/ui/round/src/premoveSequence.ts
new file mode 100644
index 0000000..249bf9a
--- /dev/null
+++ b/ui/round/src/premoveSequence.ts
@@ -0,0 +1,92 @@
+// Adapted from Mobile Maia PremoveSequence (AGPL-3.0), see extension provenance.
+// A visual plan only. Server-provided destinations authorize every execution.
+import { read, write } from '@lichess-org/chessground/fen';
+import type { Color, Key, Pieces, Role } from '@lichess-org/chessground/types';
+
+export interface QueuedMove {
+  orig: Key;
+  dest: Key;
+  promotion?: Role;
+}
+
+export class PremoveSequence {
+  readonly moves: QueuedMove[] = [];
+  generation = 0;
+  clear(): void {
+    this.moves.length = 0;
+    this.generation++;
+  }
+  add(fen: string, color: Color, move: QueuedMove): boolean {
+    if (this.moves.length >= 64) return false;
+    const piece = read(this.project(fen, color)).get(move.orig);
+    if (piece?.color !== color) return false;
+    if (piece.role === 'king' && move.orig.startsWith('e') && move.orig[1] === move.dest[1]) {
+      if (move.dest.startsWith('h')) move = { ...move, dest: ('g' + move.orig[1]) as Key };
+      if (move.dest.startsWith('a')) move = { ...move, dest: ('c' + move.orig[1]) as Key };
+    }
+    if (piece.role === 'pawn' && ['1', '8'].includes(move.dest[1]))
+      move = { ...move, promotion: move.promotion ?? 'queen' };
+    this.moves.push(move);
+    return true;
+  }
+  // Do not use this projection for legality, clocks, material or persistence.
+  project(fen: string, color: Color): string {
+    const pieces: Pieces = read(fen);
+    for (const move of this.moves) {
+      const piece = pieces.get(move.orig);
+      if (piece?.color !== color) continue;
+      if (
+        piece.role === 'king' &&
+        move.orig.startsWith('e') &&
+        move.orig[1] === move.dest[1] &&
+        ['c', 'g'].includes(move.dest[0])
+      ) {
+        const rookFrom = ((move.dest.startsWith('c') ? 'a' : 'h') + move.orig[1]) as Key;
+        const rookTo = ((move.dest.startsWith('c') ? 'd' : 'f') + move.orig[1]) as Key;
+        const rook = pieces.get(rookFrom);
+        if (rook?.role === 'rook' && rook.color === color) {
+          pieces.delete(rookFrom);
+          pieces.set(rookTo, rook);
+        }
+      }
+      if (piece.role === 'pawn' && !move.dest.startsWith(move.orig[0]) && !pieces.has(move.dest)) {
+        const captured = (move.dest[0] + move.orig[1]) as Key;
+        const enemy = pieces.get(captured);
+        if (enemy?.role === 'pawn' && enemy.color !== color) pieces.delete(captured);
+      }
+      pieces.delete(move.orig);
+      pieces.set(move.dest, { ...piece, role: move.promotion ?? piece.role });
+    }
+    return write(pieces);
+  }
+  get destinations(): Map<Key, boolean> {
+    const squares = new Map<Key, boolean>();
+    for (const move of this.moves) {
+      squares.set(move.orig, false);
+      squares.set(move.dest, true);
+    }
+    return squares;
+  }
+  take(fen: string, color: Color, dests: Map<Key, Key[]>): QueuedMove | undefined {
+    const move = this.moves.shift();
+    if (!move) return undefined;
+    const piece = read(fen).get(move.orig);
+    const allowed = dests.get(move.orig) ?? [];
+    const castleRook =
+      piece?.role === 'king' &&
+      move.orig.startsWith('e') &&
+      ['c', 'g'].includes(move.dest[0]) &&
+      move.orig[1] === move.dest[1]
+        ? (((move.dest.startsWith('c') ? 'a' : 'h') + move.orig[1]) as Key)
+        : undefined;
+    if (
+      piece?.color !== color ||
+      (!allowed.includes(move.dest) && !(castleRook && allowed.includes(castleRook))) ||
+      (move.promotion && (piece.role !== 'pawn' || !['1', '8'].includes(move.dest[1])))
+    ) {
+      this.clear();
+      return undefined;
+    }
+    return move;
+  }
+}
