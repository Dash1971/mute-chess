@@ -0,0 +1,98 @@
+// Maia3 encoding/vocabulary: CSSLab 1e13597c and Mobile Maia; see provenance.
+import { Chess } from 'chessops/chess';
+import { makeFen, parseFen } from 'chessops/fen';
+import { makeSan } from 'chessops/san';
+import type { Move, NormalMove } from 'chessops/types';
+import { makeUci, parseUci } from 'chessops/util';
+import { normalizeMove } from 'chessops/variant';
+
+export const position = (fen: string): Chess => Chess.fromSetup(parseFen(fen).unwrap()).unwrap();
+export function legalMoves(pos: Chess): NormalMove[] {
+  const moves: NormalMove[] = [];
+  const ctx = pos.ctx();
+  for (const [from, tos] of pos.allDests(ctx))
+    for (const to of tos) {
+      const promotions =
+        pos.board.get(from)?.role === 'pawn' && (to < 8 || to >= 56)
+          ? (['queen', 'rook', 'bishop', 'knight'] as const)
+          : [undefined];
+      for (const promotion of promotions) moves.push({ from, to, promotion });
+    }
+  return moves;
+}
+export function standardUci(pos: Chess, move: Move): string {
+  // Chessops represents castling as king-to-rook; Maia and standard UCI use c/g.
+  if (
+    'from' in move &&
+    pos.board.get(move.from)?.role === 'king' &&
+    pos.board.get(move.to)?.color === pos.turn
+  ) {
+    return makeUci({ ...move, to: move.from + (move.to > move.from ? 2 : -2) });
+  }
+  return makeUci(move);
+}
+export const legalUcis = (fen: string): string[] => {
+  const pos = position(fen);
+  return legalMoves(pos).map(m => standardUci(pos, m));
+};
+export const san = (fen: string, uci: string): string => {
+  const pos = position(fen);
+  const move = parseUci(uci);
+  return move && pos.isLegal(move) ? makeSan(pos, move) : uci;
+};
+export function after(fen: string, uci: string): string {
+  const pos = position(fen);
+  const parsed = parseUci(uci);
+  if (!parsed || !pos.isLegal(parsed)) throw new Error('Illegal candidate');
+  pos.play(normalizeMove(pos, parsed));
+  return makeFen(pos.toSetup());
+}
+export function policyIndex(uci: string, black: boolean): number {
+  if (black) uci = uci[0] + (9 - Number(uci[1])) + uci[2] + (9 - Number(uci[3])) + uci.slice(4);
+  const square = (f: string, rank: string) => f.charCodeAt(0) - 97 + (Number(rank) - 1) * 8;
+  if (uci.length === 5)
+    return 4096 + (uci.charCodeAt(0) - 97) * 32 + (uci.charCodeAt(2) - 97) * 4 + 'qrbn'.indexOf(uci[4]);
+  return square(uci[0], uci[1]) * 64 + square(uci[2], uci[3]);
+}
+export interface Candidate {
+  uci: string;
+  probability: number;
+}
+export function policy(fen: string, logits: Float32Array): Candidate[] {
+  if (logits.length !== 4352 || !logits.every(Number.isFinite)) throw new Error('Invalid Maia policy');
+  const black = position(fen).turn === 'black';
+  const moves = legalUcis(fen);
+  const values = moves.map(m => logits[policyIndex(m, black)]);
+  const max = Math.max(...values);
+  const weights = values.map(x => Math.exp(x - max));
+  const sum = weights.reduce((a, b) => a + b, 0);
+  return moves
+    .map((uci, i) => ({ uci, probability: weights[i] / sum }))
+    .sort((a, b) => b.probability - a.probability);
+}
+export function encodeHistory(history: string[], enabled: boolean): Float32Array {
+  const frames = enabled ? history.slice(-8) : history.slice(-1);
+  if (!frames.length) throw new Error('Missing position history');
+  while (frames.length < 8) frames.unshift(frames[0]);
+  const tokens = new Float32Array(64 * 97);
+  frames.forEach((fen, frame) => {
+    const pos = position(fen);
+    const black = pos.turn === 'black';
+    for (const [square, piece] of pos.board) {
+      const target = black ? square ^ 56 : square;
+      const role = ['pawn', 'knight', 'bishop', 'rook', 'queen', 'king'].indexOf(piece.role);
+      tokens[target * 97 + frame * 12 + role + (piece.color === pos.turn ? 0 : 6)] = 1;
+    }
+  });
+  return tokens;
+}
+export function scoreText(score?: EvalScore): string {
+  if (!score) return 'Unavailable';
+  if (score.mate !== undefined) return score.mate === 0 ? 'Checkmate' : `#${score.mate}`;
+  return score.cp === undefined ? 'Unavailable' : `${score.cp >= 0 ? '+' : ''}${(score.cp / 100).toFixed(2)}`;
+}
+export const terminalScore = (fen: string): EvalScore | undefined => {
+  const pos = position(fen);
+  if (!pos.isEnd()) return undefined;
+  return pos.isCheckmate() ? { mate: pos.turn === 'white' ? -1 : 1 } : { cp: 0 };
+};
diff --git a/ui/analyse/src/noSweatFish.ts b/ui/analyse/src/noSweatFish.ts
new file mode 100644
index 0000000..36b0e3f
--- /dev/null
+++ b/ui/analyse/src/noSweatFish.ts
@@ -0,0 +1,207 @@
+import type { BrowserEngineInfo } from 'lib/ceval';
+// Use Lila's native Stockfish loader/assets with a separate bounded review queue.
+import { StockfishWebEngine } from 'lib/ceval/engines/stockfishWebEngine';
+import { Protocol } from 'lib/ceval/protocol';
+
+import { legalUcis, position, terminalScore } from './noSweatCore';
+import { SearchSnapshots, type Snapshot } from './noSweatSnapshots';
+
+export interface Review {
+  current: Snapshot;
+  previous?: Snapshot;
+  terminal?: boolean;
+  quality?: string;
+}
+const info: BrowserEngineInfo = {
+  id: 'nosweat-review-sf19-small',
+  name: 'Stockfish 19 · 1MB',
+  tech: 'NNUE',
+  short: 'SF19',
+  minThreads: 1,
+  maxThreads: 1,
+  minMem: 1536,
+  requires: ['sharedMem', 'simd', 'dynamicImportFromWorker'],
+  assets: { root: 'npm/stockfish-web', js: 'sf_19_smallnet.js' },
+};
+class ReviewProtocol extends Protocol {
+  private output?: (command: string) => void;
+  private task?: {
+    fen: string;
+    moves: string[];
+    depth: number;
+    time: number;
+    snapshots: SearchSnapshots;
+    resolve: (r: Review) => void;
+    reject: (e: Error) => void;
+    signal: AbortSignal;
+    started: boolean;
+    timer: ReturnType<typeof setTimeout>;
+  };
+  private booted!: () => void;
+  private bootFailure!: (e: Error) => void;
+  readonly boot: Promise<void>;
+  constructor() {
+    super(info);
+    this.boot = new Promise((resolve, reject) => {
+      this.booted = resolve;
+      this.bootFailure = reject;
+    });
+    this.boot.catch(() => {});
+  }
+  override connected(send: (command: string) => void): void {
+    this.output = send;
+    send('uci');
+  }
+  override isComputing(): boolean {
+    return !!this.task;
+  }
+  override received(text: string): void {
+    if (text === 'uciok') {
+      for (const cmd of [
+        'setoption name Threads value 1',
+        'setoption name Hash value 16',
+        'setoption name UCI_Chess960 value false',
+        'setoption name UCI_AnalyseMode value true',
+        'isready',
+      ])
+        this.output?.(cmd);
+    } else if (text === 'readyok') {
+      this.booted();
+      const t = this.task;
+      if (t && !t.started) {
+        t.started = true;
+        this.output?.('position fen ' + t.fen);
+        this.output?.(
+          `go depth ${t.depth} movetime ${t.time}` +
+            (t.moves.length ? ' searchmoves ' + t.moves.join(' ') : ''),
+        );
+      }
+    } else if (text.startsWith('info ')) this.task?.snapshots.add(text);
+    else if (text.startsWith('bestmove')) {
+      const t = this.task;
+      if (!t) return;
+      clearTimeout(t.timer);
+      this.task = undefined;
+      if (t.signal.aborted) t.reject(new Error('Cancelled'));
+      else if (t.snapshots.completed)
+        t.resolve({ current: t.snapshots.completed, previous: t.snapshots.previous });
+      else t.reject(new Error('Stockfish did not finish a complete MultiPV iteration'));
+    }
+  }
+  fail(error: Error): void {
+    this.bootFailure(error);
+    const t = this.task;
+    this.task = undefined;
+    if (t) {
+      clearTimeout(t.timer);
+      t.reject(error);
+    }
+  }
+  async search(
+    fen: string,
+    moves: string[],
+    depth: number,
+    time: number,
+    signal: AbortSignal,
+  ): Promise<Review> {
+    let deadline: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await Promise.race([
+        this.boot,
+        new Promise<never>((_, reject) => {
+          deadline = setTimeout(() => reject(new Error('Stockfish startup timed out')), 45000);
+        }),
+      ]);
+    } finally {
+      clearTimeout(deadline);
+    }
+    if (signal.aborted) throw new Error('Cancelled');
+    const terminal = terminalScore(fen);
+    if (terminal) return { current: { depth: 99, lines: [{ ...terminal, moves: [] }] }, terminal: true };
+    const legal = new Set(moves.length ? moves : legalUcis(fen));
+    return new Promise((resolve, reject) => {
+      if (this.task) {
+        reject(new Error('Review queue busy'));
+        return;
+      }
+      const t = (this.task = {
+        fen,
+        moves,
+        depth,
+        time,
+        resolve,
+        reject,
+        signal,
+        started: false,
+        snapshots: new SearchSnapshots(legal, Math.min(2, legal.size), position(fen).turn === 'white'),
+        timer: setTimeout(() => this.fail(new Error('Stockfish review timed out')), time + 15000),
+      });
+      signal.addEventListener(
+        'abort',
+        () => {
+          if (this.task === t) {
+            if (t.started) this.output?.('stop');
+            else {
+              clearTimeout(t.timer);
+              this.task = undefined;
+              reject(new Error('Cancelled'));
+            }
+          }
+        },
+        { once: true },
+      );
+      this.output?.('ucinewgame');
+      this.output?.('setoption name Clear Hash');
+      this.output?.('setoption name MultiPV value ' + Math.min(2, legal.size));
+      this.output?.('isready');
+    });
+  }
+}
+class OwnedReviewEngine extends StockfishWebEngine {
+  private disposed = false;
+  override async boot(): Promise<void> {
+    await super.boot();
+    if (this.disposed) this.destroy();
+  }
+  override destroy = (): void => {
+    this.disposed = true;
+    this.module?.uci('quit');
+    this.module = undefined;
+  };
+}
+export class ReviewFish {
+  private protocol?: ReviewProtocol;
+  private engine?: StockfishWebEngine;
+  private tail: Promise<unknown> = Promise.resolve();
+  private generation = 0;
+  constructor(private readonly status: (s: string) => void) {}
+  search(fen: string, moves: string[], signal: AbortSignal, depth = 14, time = 1200): Promise<Review> {
+    const generation = this.generation;
+    const job = this.tail
+      .catch(() => {})
+      .then(async () => {
+        if (signal.aborted || generation !== this.generation) throw new Error('Cancelled');
+        if (!this.protocol) {
+          const protocol = (this.protocol = new ReviewProtocol());
+          this.engine = new OwnedReviewEngine(
+            { ...info, assets: { ...info.assets } },
+            s => {
+              if (s?.error) protocol.fail(new Error(s.error));
+              else if (s?.download) this.status('Loading Stockfish review…');
+            },
+            protocol,
+          );
+        }
+        return this.protocol.search(fen, moves, depth, time, signal);
+      });
+    this.tail = job;
+    return job;
+  }
+  destroy(): void {
+    this.generation++;
+    this.protocol?.fail(new Error('Cancelled'));
+    this.engine?.destroy();
+    this.engine = undefined;
+    this.protocol = undefined;
+  }
+}
diff --git a/ui/analyse/src/noSweatGameReview.ts b/ui/analyse/src/noSweatGameReview.ts
new file mode 100644
index 0000000..474ca27
--- /dev/null
+++ b/ui/analyse/src/noSweatGameReview.ts
@@ -0,0 +1,172 @@
+import { gameAccuracy, type GameAccuracy } from './noSweatAccuracy';
+import type { ClassificationInput, ClassificationResult } from './noSweatClassify';
+import type { Review } from './noSweatFish';
+
+export const reviewQualities = {
+  fast: { name: 'Fast', depth: 12, time: 500 },
+  balanced: { name: 'Balanced', depth: 14, time: 1000 },
+  thorough: { name: 'Thorough', depth: 16, time: 1500 },
+} as const;
+export type ReviewQuality = keyof typeof reviewQualities;
+export interface ReviewNode {
+  fen: string;
+  uci?: string;
+  san?: string;
+  path: string;
+}
+export interface GameReport {
+  key: string;
+  quality: ReviewQuality;
+  nodes: ReviewNode[];
+  reviews: Review[];
+  moves: (ClassificationResult | undefined)[];
+  unavailable: number[];
+  accuracy?: GameAccuracy;
+  state: 'idle' | 'evaluating' | 'classifying' | 'confirming' | 'complete' | 'stopped' | 'failed';
+  completed: number;
+  total: number;
+  error?: string;
+}
+interface Dependencies {
+  search: (fen: string, signal: AbortSignal, depth: number, time: number) => Promise<Review>;
+  classify: (input: ClassificationInput, signal: AbortSignal) => Promise<ClassificationResult>;
+  changed: () => void;
+}
+export const gameReviewKey = (nodes: ReviewNode[], quality: ReviewQuality): string =>
+  JSON.stringify(['sf19-small-mobilemaia-full-v1', quality, nodes.map(n => [n.path, n.fen, n.uci])]);
+export class GameReview {
+  report?: GameReport;
+  private abort?: AbortController;
+  private generation = 0;
+  private readonly cache = new Map<string, Review>();
+  constructor(private readonly deps: Dependencies) {}
+  observe(nodes: ReviewNode[], quality: ReviewQuality): void {
+    if (this.report && this.report.key !== gameReviewKey(nodes, quality)) {
+      this.report = undefined;
+      this.stop();
+    }
+  }
+  resultAt(path: string, fen: string): ClassificationResult | undefined {
+    const report = this.report;
+    if (!report) return undefined;
+    const index = report.nodes.findIndex(n => n.path === path && n.fen === fen);
+    return index > 0 ? report.moves[index - 1] : undefined;
+  }
+  get running(): boolean {
+    return !!this.abort;
+  }
+  stop(): void {
+    this.generation++;
+    this.abort?.abort();
+    this.abort = undefined;
+    if (this.report && ['evaluating', 'classifying', 'confirming'].includes(this.report.state))
+      this.report.state = 'stopped';
+    this.deps.changed();
+  }
+  async start(nodes: ReviewNode[], quality: ReviewQuality): Promise<void> {
+    if (this.report?.state === 'complete') this.cache.clear();
+    this.stop();
+    if (nodes.length < 2) return;
+    const generation = this.generation;
+    const abort = (this.abort = new AbortController());
+    const current = () => generation === this.generation && !abort.signal.aborted;
+    const mode = reviewQualities[quality];
+    const report: GameReport = (this.report = {
+      key: gameReviewKey(nodes, quality),
+      quality,
+      nodes: nodes.map(n => ({ ...n })),
+      reviews: [],
+      moves: Array.from({ length: nodes.length - 1 }, () => undefined),
+      unavailable: [],
+      state: 'evaluating',
+      completed: 0,
+      total: nodes.length,
+    });
+    this.deps.changed();
+    const search = async (fen: string, confirmation = false): Promise<Review> => {
+      if (!current()) throw new Error('Cancelled');
+      const depth = mode.depth + (confirmation ? 2 : 0);
+      const key = JSON.stringify([fen, quality, depth, mode.time]);
+      const cached = this.cache.get(key);
+      if (cached) return cached;
+      const result = await this.deps.search(fen, abort.signal, depth, mode.time);
+      if (!current()) throw new Error('Cancelled');
+      const review = { ...result, quality };
+      this.cache.set(key, review);
+      if (this.cache.size > 800) this.cache.delete(this.cache.keys().next().value!);
+      return review;
+    };
+    try {
+      for (const node of report.nodes) {
+        report.reviews.push(await search(node.fen));
+        if (!current()) return;
+        report.completed++;
+        this.deps.changed();
+      }
+      report.accuracy = gameAccuracy(
+        report.reviews.map(r => r.current.lines[0]),
+        report.nodes[0].fen.split(' ')[1] === 'w',
+      );
+      report.state = 'classifying';
+      report.completed = 0;
+      report.total = nodes.length - 1;
+      this.deps.changed();
+      for (let ply = 1; ply < nodes.length; ply++) {
+        if (!current()) return;
+        const first = Math.max(0, ply - 2);
+        const input: ClassificationInput = {
+          positions: nodes.slice(first, ply + 1).map(n => n.fen),
+          reviews: report.reviews.slice(first, ply + 1),
+          move: nodes[ply].uci!,
+        };
+        try {
+          report.moves[ply - 1] = await this.deps.classify(input, abort.signal);
+        } catch {
+          if (!current()) return;
+          report.unavailable.push(ply);
+        }
+        if (!current()) return;
+        report.completed++;
+        this.deps.changed();
+      }
+      // Match Mobile Maia's six-search budget for uncorroborated standout windows.
+      report.state = 'confirming';
+      let budget = 6;
+      this.deps.changed();
+      for (let ply = 1; ply < nodes.length; ply++) {
+        const provisional = report.moves[ply - 1];
+        if (!provisional?.withheld || !['!', '!!'].includes(provisional.provisional ?? '')) continue;
+        const first = provisional.provisional === '!' ? Math.max(0, ply - 2) : ply - 1;
+        const cost = ply - first + 1;
+        if (cost > budget) continue;
+        budget -= cost;
+        const baselineFirst = Math.max(0, ply - 2);
+        try {
+          const confirmation = await Promise.all(nodes.slice(first, ply + 1).map(n => search(n.fen, true)));
+          if (!current()) return;
+          const input: ClassificationInput = {
+            positions: nodes.slice(baselineFirst, ply + 1).map(n => n.fen),
+            reviews: report.reviews.slice(baselineFirst, ply + 1),
+            move: nodes[ply].uci!,
+            confirmation,
+          };
+          report.moves[ply - 1] = await this.deps.classify(input, abort.signal);
+          if (!current()) return;
+        } catch {
+          if (!current()) return; /* Unsupported standout stays withheld; baseline review is unchanged. */
+        }
+        this.deps.changed();
+      }
+      if (!current()) return;
+      report.state = 'complete';
+      this.abort = undefined;
+      this.deps.changed();
+    } catch (error) {
+      if (!current()) return;
+      report.state = 'failed';
+      report.error = String(error instanceof Error ? error.message : error);
+      this.abort = undefined;
+      this.deps.changed();
+    }
+  }
+}
diff --git a/ui/analyse/src/noSweatPreferences.ts b/ui/analyse/src/noSweatPreferences.ts
new file mode 100644
index 0000000..583d821
--- /dev/null
+++ b/ui/analyse/src/noSweatPreferences.ts
@@ -0,0 +1,40 @@
+import type { ReviewQuality } from './noSweatGameReview';
+export interface EnginePreferences {
+  model: '5m' | '79m';
+  selfElo: number;
+  opponentElo: number;
+  history: boolean;
+  maiaArrows: boolean;
+  fishArrows: boolean;
+  quality: ReviewQuality;
+}
+export const defaultEnginePreferences: EnginePreferences = {
+  model: '5m',
+  selfElo: 1500,
+  opponentElo: 1500,
+  history: true,
+  maiaArrows: true,
+  fishArrows: true,
+  quality: 'fast',
+};
+export function readEnginePreferences(raw: string | null): EnginePreferences {
+  let input: Partial<EnginePreferences> = {};
+  try {
+    input = JSON.parse(raw ?? '{}') ?? {};
+  } catch {
+    /* Invalid browser preference falls back safely. */
+  }
+  const rating = (n: unknown) =>
+    typeof n === 'number' && Number.isInteger(n) && n >= 600 && n <= 2600 && n % 100 === 0 ? n : 1500;
+  const boolean = (key: 'history' | 'maiaArrows' | 'fishArrows') =>
+    typeof input[key] === 'boolean' ? input[key] : true;
+  return {
+    model: input.model === '79m' ? '79m' : '5m',
+    selfElo: rating(input.selfElo),
+    opponentElo: rating(input.opponentElo),
+    history: boolean('history'),
+    maiaArrows: boolean('maiaArrows'),
+    fishArrows: boolean('fishArrows'),
+    quality: input.quality === 'balanced' || input.quality === 'thorough' ? input.quality : 'fast',
+  };
+}
