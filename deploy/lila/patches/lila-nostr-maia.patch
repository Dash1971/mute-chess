+  private def recoveryHash(code: String): String =
+    java.util.HexFormat
+      .of()
+      .formatHex(
+        java.security.MessageDigest
+          .getInstance("SHA-256")
+          .digest(code.replace("-", "").toLowerCase.getBytes(java.nio.charset.StandardCharsets.UTF_8))
+      )
