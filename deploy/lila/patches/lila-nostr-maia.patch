+const jobs: { signal: AbortSignal; resolve: (r: Review) => void; options?: CandidateSearchOptions }[] = [];
+class FakeFish {
+  search(
+    _fen: string,
+    _moves: string[],
+    signal: AbortSignal,
+    _depth?: number,
+    _time?: number,
+    _session?: symbol,
+    _multiPv?: number,
