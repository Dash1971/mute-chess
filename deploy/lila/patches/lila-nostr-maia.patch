@@ -0,0 +1,144 @@
+// Mobile Maia / En Croissant annotations over native Lichess analysis.
+// Accuracy, ACPL, best lines and Learn from your mistakes stay native.
+import { parseUci } from 'chessops/util';
+
+import { gameReviewQualities } from 'lib/nosweat/reviewQuality';
+import type { Glyph, TreeNodeBase } from 'lib/tree/types';
+
+import { type Annotation, type ClassificationInput, type ClassificationResult } from './noSweatClassify';
+import { legalUcis, position, standardUci, terminalScore } from './noSweatCore';
+import type { Review } from './noSweatFish';
+
+export const reviewSource = 'mobile-maia-full-review-v2';
+export const moveClasses = [
+  { symbol: '!!', id: 3, name: 'Brilliant', color: '#15aabf' },
+  { symbol: '!', id: 1, name: 'Good', color: '#12b886' },
+  { symbol: '!?', id: 5, name: 'Interesting', color: '#82c91e' },
+  { symbol: '?!', id: 6, name: 'Dubious', color: '#fab005' },
+  { symbol: '?', id: 2, name: 'Mistake', color: '#fd7e14' },
+  { symbol: '??', id: 4, name: 'Blunder', color: '#fa5252' },
+] as const;
+export const qualityGlyph = (symbol: Annotation): Glyph | undefined => {
+  const c = moveClasses.find(c => c.symbol === symbol);
+  return c && { id: c.id, name: c.name, symbol, comp: true, source: reviewSource };
+};
+
+export { gameReviewQualities, gameReviewQuality } from 'lib/nosweat/reviewQuality';
+
+export function nativeReview(node: TreeNodeBase): Review | undefined {
+  const terminal = terminalScore(node.fen);
+  if (terminal)
+    return {
+      current: { depth: 99, lines: [{ ...terminal, moves: [] }] },
+      terminal: true,
+      quality: reviewSource,
+    };
+  const evals = node.eval?.pvs;
+  if (!evals || evals.length < Math.min(2, legalUcis(node.fen).length)) return undefined;
+  const pos = position(node.fen);
+  const lines = evals.slice(0, 2).map(pv => ({
+    ...pv,
+    moves: pv.moves.split(' ').map((uci, i) => {
+      const move = parseUci(uci);
+      return i === 0 && move ? standardUci(pos, move) : uci;
+    }),
+  }));
+  if (new Set(lines.map(l => l.moves[0])).size !== lines.length) return undefined;
+  return { current: { depth: node.eval?.depth ?? 0, lines }, quality: reviewSource };
+}
+
+interface Dependencies {
+  classify(input: ClassificationInput, signal: AbortSignal): Promise<ClassificationResult>;
+  search(fen: string, signal: AbortSignal, depth: number, time: number, session?: symbol): Promise<Review>;
+}
+export class FullGameClassifier {
+  constructor(private readonly deps: Dependencies) {}
+  async run(
+    nodes: TreeNodeBase[],
+    signal: AbortSignal,
+    current: () => boolean,
+    progress: (done: number, total: number, phase?: string) => void,
+    quality: { depth: number; movetime: number } = gameReviewQualities[0],
+  ): Promise<Map<number, Annotation>> {
+    const valid = () => {
+      if (signal.aborted || !current()) throw new Error('Cancelled');
+    };
+    const results = new Map<number, Annotation>();
+    if (!nodes.slice(1).some(n => n.uci && !n.glyphs?.some(g => !g.comp && g.id >= 1 && g.id <= 6)))
+      return results;
+    // Mobile Maia reviews the line forwards in one isolated engine session.
+    // Native replay evaluates backwards and does not retain earlier complete
+    // iterations. Keep its graph/accuracy untouched, and collect the complete
+    // classification evidence separately instead of silently dropping it.
+    const session = Symbol();
+    const reviews: Review[] = [];
+    for (const [i, node] of nodes.entries()) {
+      valid();
+      progress(i, nodes.length - 1, 'Checking move evidence');
+      reviews.push({
+        ...(await this.deps.search(node.fen, signal, quality.depth, quality.movetime, session)),
+        quality: `${reviewSource}:${quality.depth}:${quality.movetime}`,
+      });
+      valid();
+    }
+    let confirmationBudget = 6;
+    for (let i = 1; i < nodes.length; i++) {
+      valid();
+      progress(i - 1, nodes.length - 1);
+      if (!nodes[i].uci || nodes[i].glyphs?.some(g => !g.comp && g.id >= 1 && g.id <= 6)) continue;
+      const window = nodes.slice(Math.max(0, i - 2), i + 1);
+      const windowReviews = reviews.slice(Math.max(0, i - 2), i + 1);
+      const before = window[window.length - 2];
+      const move = parseUci(nodes[i].uci!);
+      if (!move) continue;
+      const input = {
+        positions: window.map(n => n.fen),
+        reviews: windowReviews,
+        move: standardUci(position(before.fen), move),
+      };
+      let result = await this.deps.classify(input, signal);
+      valid();
+      const provisional = result.provisional ?? result.symbol;
+      // A complete earlier-iteration window is already corroboration. Only an
+      // unsupported award consumes Mobile Maia's six-search check allowance.
+      if ((provisional === '!!' || provisional === '!') && result.withheld) {
+        const start = provisional === '!' && i > 1 ? i - 2 : i - 1;
+        const cost = i - start + 1;
+        if (cost > confirmationBudget) continue;
+        confirmationBudget -= cost;
+        const confirmation: Review[] = [];
+        const confirmationSession = Symbol();
+        for (let n = start; n <= i; n++) {
+          valid();
+          confirmation.push({
+            ...(await this.deps.search(
+              nodes[n].fen,
+              signal,
+              quality.depth + 2,
+              quality.movetime,
+              confirmationSession,
+            )),
+            quality: reviews[n].quality,
+          });
+          valid();
+        }
+        result = await this.deps.classify({ ...input, confirmation }, signal);
+        valid();
+      }
+      if (!result.withheld) results.set(nodes[i].ply, result.symbol);
+    }
+    valid();
+    progress(nodes.length - 1, nodes.length - 1);
+    return results;
+  }
+}
+
+export function classificationCounts(nodes: TreeNodeBase[], color: Color): number[] {
+  const counts = moveClasses.map(() => 0);
+  for (const node of nodes) {
+    if (!node.uci || (node.ply % 2 === 1 ? 'white' : 'black') !== color) continue;
+    const category = moveClasses.findIndex(c => node.glyphs?.some(g => g.id === c.id));
+    if (category !== -1) counts[category]++;
+  }
+  return counts;
+}
diff --git a/ui/analyse/src/noSweatMoveTooltip.ts b/ui/analyse/src/noSweatMoveTooltip.ts
new file mode 100644
index 0000000..0220987
--- /dev/null
+++ b/ui/analyse/src/noSweatMoveTooltip.ts
@@ -0,0 +1,151 @@
+import type { Hooks, VNode } from 'lib/view';
+
+// Maia's MoveTooltip presentation, adapted to the native analysis DOM.
+export interface MoveTooltipDetails {
+  san: string;
+  color: string;
+  maiaProbability?: number;
+  stockfishEval?: string;
+  stockfishWinrate?: number;
+  stockfishEvalLoss?: string;
+}
+
+let nextId = 0;
+let hideActive: (() => void) | undefined;
+const attachedTooltips = new WeakMap<HTMLElement | SVGElement, () => void>();
+const dismissedTooltips = new WeakSet<HTMLElement | SVGElement>();
+
+export function attachMoveTooltip(
+  element: HTMLElement | SVGElement,
+  details: () => MoveTooltipDetails | undefined,
+): () => void {
+  const id = `nosweat-move-tooltip-${++nextId}`;
+  let popup: HTMLElement | undefined;
+  let hovered = false;
+  let focused = false;
+
+  const hide = () => {
+    popup?.remove();
+    popup = undefined;
+    const describedBy = element
+      .getAttribute('aria-describedby')
+      ?.split(/\s+/)
+      .filter(value => value !== id);
+    if (describedBy?.length) element.setAttribute('aria-describedby', describedBy.join(' '));
+    else element.removeAttribute('aria-describedby');
+    window.removeEventListener('scroll', hide, true);
+    window.removeEventListener('resize', hide);
+    window.removeEventListener('keydown', escape);
+    if (hideActive === hide) hideActive = undefined;
+  };
+  const escape = (event: KeyboardEvent) => {
+    if (event.key === 'Escape') {
+      dismissedTooltips.add(element);
+      hide();
+    }
+  };
+  const show = () => {
+    if (dismissedTooltips.has(element) || popup || !element.isConnected) return;
+    const data = details();
+    if (!data) return;
+    hideActive?.();
+    popup = document.createElement('div');
+    popup.className = 'nosweat-move-tooltip';
+    popup.id = id;
+    popup.setAttribute('role', 'tooltip');
+    const header = document.createElement('div');
+    header.className = 'nosweat-move-tooltip__header';
+    header.textContent = data.san;
+    header.style.color = data.color;
+    popup.append(header);
+    const rows = document.createElement('div');
+    rows.className = 'nosweat-move-tooltip__rows';
+    const row = (label: string, value: string, maia = false) => {
+      const name = document.createElement('span');
+      name.className = maia ? 'nosweat-move-tooltip__maia' : 'nosweat-move-tooltip__fish';
+      name.textContent = label;
+      const number = document.createElement('span');
+      number.textContent = value;
+      rows.append(name, number);
+    };
+    if (data.maiaProbability !== undefined)
+      row('Maia:', `${(Math.round(data.maiaProbability * 1000) / 10).toFixed(1)}%`, true);
+    if (data.stockfishEval !== undefined) row('SF Eval:', data.stockfishEval);
+    if (data.stockfishWinrate !== undefined)
+      row('SF Winrate:', `${(data.stockfishWinrate * 100).toFixed(1)}%`);
+    if (data.stockfishEvalLoss !== undefined) row('SF Eval Loss:', data.stockfishEvalLoss);
+    popup.append(rows);
+    document.body.append(popup);
+    const anchor = element.getBoundingClientRect();
+    const box = popup.getBoundingClientRect();
+    const maxLeft = Math.max(8, window.innerWidth - box.width - 8);
+    const maxTop = Math.max(8, window.innerHeight - box.height - 8);
+    popup.style.left = `${Math.min(maxLeft, Math.max(8, anchor.left))}px`;
+    popup.style.top = `${Math.min(maxTop, Math.max(8, anchor.top >= box.height + 10 ? anchor.top - box.height - 10 : anchor.bottom + 10))}px`;
+    const describedBy = element.getAttribute('aria-describedby');
+    element.setAttribute('aria-describedby', [describedBy, id].filter(Boolean).join(' '));
+    hideActive = hide;
+    window.addEventListener('scroll', hide, true);
+    window.addEventListener('resize', hide);
+    window.addEventListener('keydown', escape);
+  };
+  const enter = () => {
+    hovered = true;
+    dismissedTooltips.delete(element);
+    show();
+  };
+  const leave = () => {
+    hovered = false;
+    if (!focused) hide();
+  };
+  const focus = () => {
+    focused = true;
+    dismissedTooltips.delete(element);
+    show();
+  };
+  const blur = () => {
+    focused = false;
+    if (!hovered) hide();
+  };
+  element.addEventListener('mouseenter', enter);
+  element.addEventListener('mouseleave', leave);
+  element.addEventListener('focus', focus);
+  element.addEventListener('blur', blur);
+  focused = document.activeElement === element;
+  hovered = element.matches(':hover');
+  if (focused || hovered) show();
+
+  return () => {
+    hide();
+    element.removeEventListener('mouseenter', enter);
+    element.removeEventListener('mouseleave', leave);
+    element.removeEventListener('focus', focus);
+    element.removeEventListener('blur', blur);
+  };
+}
+
+export function withMoveTooltip(hooks: Hooks, details: () => MoveTooltipDetails | undefined): Hooks {
+  const attach = (vnode: VNode) => {
+    const element = vnode.elm as HTMLElement | SVGElement;
+    attachedTooltips.get(element)?.();
+    attachedTooltips.set(element, attachMoveTooltip(element, details));
+  };
+  return {
+    ...hooks,
+    insert: vnode => {
+      hooks.insert?.(vnode);
+      attach(vnode);
+    },
+    update: (old, vnode) => {
+      hooks.update?.(old, vnode);
+      attach(vnode);
+    },
+    destroy: vnode => {
+      const element = vnode.elm as HTMLElement | SVGElement;
+      attachedTooltips.get(element)?.();
+      attachedTooltips.delete(element);
+      dismissedTooltips.delete(element);
+      hooks.destroy?.(vnode);
+    },
+  };
+}
diff --git a/ui/analyse/src/noSweatOpening.ts b/ui/analyse/src/noSweatOpening.ts
new file mode 100644
index 0000000..a619492
--- /dev/null
+++ b/ui/analyse/src/noSweatOpening.ts
@@ -0,0 +1,130 @@
+import { Chess } from 'chessops/chess';
+import { makeFen, parseFen } from 'chessops/fen';
+
+import { escapeHtml } from 'lib';
+import { domDialog } from 'lib/view';
+
+import type AnalyseCtrl from './ctrl';
+
+export type OpeningEntry = readonly [epd: string, eco: string, name: string];
+let entries: Map<string, string> | undefined;
+let loading: Promise<void> | undefined;
+
+export function openingEpd(fen: string): string | undefined {
+  try {
+    const setup = parseFen(fen).unwrap();
+    // Match Mobile Maia / Lichess EPD normalization, including legal en passant.
+    const pos = Chess.fromSetup(setup).unwrap();
+    return makeFen(pos.toSetup()).split(' ').slice(0, 4).join(' ');
+  } catch {
+    return undefined;
+  }
+}
+
+export function identifyOpening(
+  fens: readonly string[],
+  table: ReadonlyMap<string, string>,
+): string | undefined {
+  for (let i = fens.length - 1; i >= 0; i--) {
+    const epd = openingEpd(fens[i]);
+    const name = epd && table.get(epd);
+    if (name) return name;
+  }
+  return undefined;
+}
+
+function loadOpenings(): Promise<void> {
+  return (loading ??= fetch(site.asset.url('nosweat/openings.json'))
+    .then(response => {
+      if (!response.ok) throw new Error('Opening names unavailable');
+      return response.json();
+    })
+    .then((rows: OpeningEntry[]) => {
+      entries = new Map(rows.map(([epd, eco, name]) => [epd, `${eco} · ${name}`]));
+    }));
+}
+
+export class OpeningLabel {
+  private readonly row = document.createElement('div');
+  private readonly label = document.createElement('button');
+  private readonly observer: ResizeObserver;
+  private name = '';
+  private context = '';
+
+  constructor(
+    private readonly ctrl: AnalyseCtrl,
+    underboard: HTMLElement,
+  ) {
+    this.row.className = 'nosweat-opening';
+    this.label.type = 'button';
+    this.label.className = 'nosweat-opening-name';
+    this.label.hidden = true;
+    this.row.append(this.label);
+    underboard.prepend(this.row);
+    this.label.onclick = () => {
+      if (this.label.scrollWidth <= this.label.clientWidth) return;
+      domDialog({
+        modal: true,
+        show: true,
+        easyClose: 'clickOutside',
+        class: 'nosweat-opening-dialog',
+        htmlText: `<h2>${escapeHtml(i18n.site.opening)}</h2><p>${escapeHtml(this.name)}</p><button class="button">${escapeHtml(i18n.site.close)}</button>`,
+        actions: [{ selector: 'button', listener: (_event, dialog) => dialog.close() }],
+      });
+    };
+    this.observer = new ResizeObserver(() => this.measure());
+    this.observer.observe(this.label);
+    const playerStrip = underboard.closest('.analyse')?.querySelector('.analyse__player_strip.bottom');
+    if (playerStrip) this.observer.observe(playerStrip);
+    void document.fonts?.ready.then(() => this.measure());
+    window.addEventListener('pagehide', () => this.observer.disconnect(), { once: true });
+    void loadOpenings()
+      .then(() => this.redraw())
+      .catch(() => this.redraw());
+    this.redraw();
+  }
+
+  redraw(): void {
+    if (!this.row.isConnected) return;
+    const context = `${this.ctrl.path}:${this.ctrl.node.fen}:${!!entries}`;
+    if (context === this.context) return;
+    this.context = context;
+    const path = this.ctrl.nodeList;
+    const fallback = this.ctrl.data.game.opening;
+    // A final-game opening is a safe fallback only once its own node is on this path.
+    this.name =
+      (entries &&
+        identifyOpening(
+          path.map(n => n.fen),
+          entries,
+        )) ||
+      (fallback &&
+      path.some(
+        n => n.ply === fallback.ply && n.fen === this.ctrl.mainline.find(m => m.ply === fallback.ply)?.fen,
+      )
+        ? `${fallback.eco} · ${fallback.name}`
+        : '');
+    this.label.textContent = this.name;
+    this.label.hidden = !this.name;
+    this.label.title = this.name;
+    this.measure();
+  }
+
+  destroy(): void {
+    this.observer.disconnect();
+    this.row.remove();
+  }
+
+  private measure(): void {
+    // Native material and clocks share this row. Keep the name centered on the
+    // board by reserving the lower player strip's width on both sides.
+    const strip = this.row.closest('.analyse')?.querySelector('.analyse__player_strip.bottom');
+    const width = strip?.getBoundingClientRect().width ?? 0;
+    this.row.style.setProperty('--nosweat-opening-clearance', `${width > 1 ? Math.ceil(width) + 8 : 0}px`);
+    const truncated = this.label.scrollWidth > this.label.clientWidth;
+    this.label.disabled = !truncated;
+    this.label.classList.toggle('truncated', truncated);
+    this.label.setAttribute('aria-label', this.name + (truncated ? '. Show full opening name' : ''));
+    this.label.setAttribute('aria-haspopup', truncated ? 'dialog' : 'false');
+  }
+}
diff --git a/ui/analyse/src/noSweatPgn.ts b/ui/analyse/src/noSweatPgn.ts
new file mode 100644
index 0000000..a908da3
--- /dev/null
+++ b/ui/analyse/src/noSweatPgn.ts
@@ -0,0 +1,85 @@
+import { INITIAL_FEN } from 'chessops/fen';
+import { ChildNode, Node, makeComment, makeOutcome, makePgn, type PgnNodeData } from 'chessops/pgn';
+
+import type { TreeNodeLite } from 'lib/tree/types';
+
+import type AnalyseCtrl from './ctrl';
+import { position } from './noSweatCore';
+
+export type PgnExportMode = 'annotated' | 'raw';
+
+// Use the same Chessops PGN model as native import. Export the actual tree,
+// including annotations and variations, rather than an unsubmitted import draft.
+// Native postgame raw export rebuilds SAN without any comments or NAGs, even
+// imported ones (game/PgnDump.scala; api/PgnDump.scala). Raw follows that mainline
+// behavior; annotated includes all variations. Both use current board headers.
+export function boardPgn(ctrl: AnalyseCtrl, mode: PgnExportMode = 'annotated'): string {
+  const annotated = mode === 'annotated';
+  const root = ctrl.tree.root;
+  let end: TreeNodeLite = root;
+  while (end.children[0]) end = end.children[0];
+  const headers = new Map(
+    ctrl.data.noSweatPgnHeaders ?? [
+      ['Event', 'Analysis'],
+      ['Site', 'https://mutechess.org'],
+      ['Date', '????.??.??'],
+      ['Round', '?'],
+      ['White', '?'],
+      ['Black', '?'],
+      ['Result', makeOutcome(position(end.fen).outcome())],
+    ],
+  );
+  const outcome = position(end.fen).outcome();
+  if (outcome) headers.set('Result', makeOutcome(outcome));
+  if (root.fen !== INITIAL_FEN) {
+    headers.set('SetUp', '1');
+    headers.set('FEN', root.fen);
+  } else {
+    headers.delete('SetUp');
+    headers.delete('FEN');
+  }
+  const moves = new Node<PgnNodeData>();
+  const append = (into: Node<PgnNodeData>, from: TreeNodeLite) => {
+    for (const child of annotated ? from.children : from.children.slice(0, 1)) {
+      if (!child.san) continue;
+      const comments = annotated ? (child.comments?.map(c => c.text) ?? []) : [];
+      const score = annotated ? (child.eval ?? child.ceval) : undefined;
+      const clock =
+        annotated && child.clock !== undefined && Number.isFinite(child.clock) && child.clock >= 0
+          ? child.clock / 100
+          : undefined;
+      if (score?.mate !== undefined || score?.cp !== undefined || clock !== undefined)
+        comments.push(
+          makeComment({
+            evaluation:
+              score?.mate !== undefined
+                ? { mate: score.mate, depth: score.depth }
+                : score?.cp !== undefined
+                  ? { pawns: score.cp / 100, depth: score.depth }
+                  : undefined,
+            clock,
+          }),
+        );
+      const node = new ChildNode<PgnNodeData>({
+        san: child.san,
+        nags: annotated ? [...new Set(child.glyphs?.map(g => g.id))] : undefined,
+        comments,
+      });
+      into.children.push(node);
+      append(node, child);
+    }
+  };
+  append(moves, root);
+  return makePgn({ headers, moves, comments: annotated ? root.comments?.map(c => c.text) : undefined });
+}
+
+export function downloadBoardPgn(ctrl: AnalyseCtrl, mode: PgnExportMode = 'annotated'): void {
+  const url = URL.createObjectURL(
+    new Blob([boardPgn(ctrl, mode)], { type: 'application/x-chess-pgn;charset=utf-8' }),
+  );
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = mode === 'raw' ? 'mutechess-analysis-raw.pgn' : 'mutechess-analysis.pgn';
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
