diff --git a/public/nosweat/club.js b/public/nosweat/club.js
new file mode 100644
index 0000000..1e0ebae
--- /dev/null
+++ b/public/nosweat/club.js
@@ -0,0 +1,63 @@
+'use strict';
+const $ = id => document.getElementById(id);
+let bots = [];
+let signedIn = false;
+async function request(path, body, headers = {}) {
+  const response = await fetch(path, { method: body ? 'POST' : 'GET', credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json', Accept: 'application/json', ...headers },
+    body: body ? JSON.stringify(body) : undefined });
+  const result = await response.json();
+  if (!response.ok) throw Error(result.error || 'The club is temporarily unavailable.');
+  return result;
+}
+function profile() {
+  const bot = bots.find(b => b.id === $('bot').value);
+  if (!bot) return;
+  const prior = bot.ratings[$('control').value];
+  $('profile').textContent = `${bot.name} · estimated ${prior.initial_rating}? (RD ${prior.initial_rd}). ` +
+    `Maia3 79M · both conditioning inputs ${bot.conditioning_self} · ${bot.sampling_profile} sampling` +
+    (bot.opening.full_moves ? ' after five full-sampling opening moves' : '') +
+    '. History is chosen 50/50 once per game. Variable human timing. ' +
+    (bot.conditioning_self >= 2200 ? 'Experimental, unvalidated policy.' : 'Provisional, unvalidated policy.');
+}
+async function session() {
+  const { user } = await request('/club/me');
+  signedIn = !!user;
+  $('signin').hidden = signedIn; $('account').hidden = !signedIn; $('play').disabled = !signedIn;
+  if (user) { $('welcome').textContent = 'Welcome, ' + user.username; $('history').href = '/@/' + encodeURIComponent(user.username); }
+}
+$('login').addEventListener('click', async () => {
+  $('status').textContent = '';
+  if (!window.nostr) { $('status').textContent = 'Open this page in a desktop browser with a NIP-07 Nostr signer to sign in.'; return; }
+  $('login').disabled = true;
+  try {
+    const pubkey = await window.nostr.getPublicKey();
+    const challenge = await request('/club/challenge', { pubkey });
+    const body = { challenge: challenge.challenge };
+    if ($('username').value.trim()) body.username = $('username').value.trim();
+    const raw = JSON.stringify(body);
+    const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
+    const payload = [...new Uint8Array(hash)].map(byte => byte.toString(16).padStart(2, '0')).join('');
+    const event = await window.nostr.signEvent({ kind: 27235, created_at: Math.floor(Date.now() / 1000), content: '',
+      tags: [['u', challenge.url], ['method', 'POST'], ['challenge', challenge.challenge], ['payload', payload]] });
+    await request('/club/login', body, { Authorization: 'Nostr ' + btoa(JSON.stringify(event)) });
+    await session(); $('status').textContent = 'Signed in. Choose an opponent to play.';
+  } catch (error) { $('status').textContent = error.message; }
+  finally { $('login').disabled = false; }
+});
+$('play').addEventListener('click', async () => {
+  if (!signedIn) return;
+  $('play').disabled = true; $('status').textContent = 'Finding your seat…';
+  try {
+    const game = await request('/club/play', { bot: $('bot').value, control: $('control').value, color: $('color').value });
+    location.assign(game.url);
+  } catch (error) { $('status').textContent = error.message; $('play').disabled = false; }
+});
+$('bot').addEventListener('change', profile); $('control').addEventListener('change', profile);
+(async () => {
+  try {
+    bots = await request('/club/roster');
+    for (const bot of bots) { const option = document.createElement('option'); option.value = bot.id; option.textContent = bot.name; $('bot').append(option); }
+    profile(); await session();
+  } catch (error) { $('status').textContent = error.message; }
+})();
diff --git a/public/nosweat/index.html b/public/nosweat/index.html
new file mode 100644
index 0000000..3a4a4c7
--- /dev/null
+++ b/public/nosweat/index.html
@@ -0,0 +1,24 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>No Sweat Chess · Alpha</title><link rel="stylesheet" href="/assets/nosweat/club.css">
+<script defer src="/assets/nosweat/club.js"></script></head>
+<body><main>
+<header><a class="brand" href="/club">No Sweat Chess</a><span>Unrated alpha</span></header>
+<h1>Stay human. Play bots.</h1>
+<p class="lead">Choose a Maia opponent. Play on the Lichess board. Review with browser Stockfish.</p>
+<p class="notice">All games are unrated. Opponent ratings are provisional estimates, not measured strength.</p>
