diff --git a/public/nosweat/brand.css b/public/nosweat/brand.css
new file mode 100644
index 0000000..198514c
--- /dev/null
+++ b/public/nosweat/brand.css
@@ -0,0 +1,121 @@
+.site-title .nosweat-header-icon{width:38px;height:38px;margin-right:7px}.site-title .nosweat-wordmark{width:174px;height:50px;object-fit:contain}.nosweat-light{display:none}.light .nosweat-dark{display:none}.light .nosweat-light{display:block}.nosweat-login-wordmark{width:272px;max-width:100%;height:62px}.auth__brand{justify-content:center}@media(max-width:799px){.site-title .nosweat-wordmark{display:none!important}.site-title .nosweat-header-icon{width:36px;height:36px;margin:0}}
+
+main.lobby .lobby__app__content{background-image:url("/assets/nosweat/watermark-dark.svg")}.light main.lobby .lobby__app__content{background-image:url("/assets/nosweat/watermark-light.svg")}
+
+
+.nosweat-analysis { padding:.7em; border-bottom:1px solid var(--c-border); font-size:.85em; max-height:48vh; overflow:auto; flex-shrink:0; }
+.nosweat-analysis__heading,.nosweat-analysis__settings,.nosweat-analysis__options,.nosweat-analysis__actions { display:flex; flex-wrap:wrap; align-items:center; gap:.4em .7em; }
+.nosweat-analysis__heading { justify-content:space-between; }
+.nosweat-analysis__note { color:var(--c-font-dim); margin:.5em 0; }
+.nosweat-analysis__settings label { display:flex; align-items:center; gap:.3em; }
+.nosweat-analysis select { max-width:13em; padding:.25em; }
+.nosweat-analysis input[type=checkbox] { margin-right:.3em; }
+.nosweat-analysis small { display:block; color:var(--c-font-dim); font-size:.85em; }
+.nosweat-analysis table { width:100%; text-align:right; border-collapse:collapse; margin:.5em 0; }
+.nosweat-analysis td,.nosweat-analysis th { padding:.3em; border-bottom:1px solid var(--c-border); }
+.nosweat-analysis td:first-child,.nosweat-analysis th:first-child { text-align:left; }
+.nosweat-analysis button { padding:.3em .5em; }
+.nosweat-analysis__actions { margin:.5em 0; }
+.nosweat-rating-scroll { overflow:auto; }
+.nosweat-analysis .error { color:var(--c-bad); }
+
+.nosweat-candidates button,.nosweat-ratings button { text-transform:none; }
+cg-board square.nosweat-premove-origin { background:rgb(20 30 85 / .16); }
+cg-board square.nosweat-premove-dest { background:rgb(20 30 85 / .28); }
+
+.nosweat-engine-settings .setting { display:flex; align-items:center; justify-content:space-between; gap:1em; padding:.35em 0; }
+.nosweat-engine-settings select { max-width:13em; padding:.3em; }
+.nosweat-engine-settings small { display:block; margin-top:.7em; color:var(--c-font-dim); }
+.nosweat-game-review { padding:1em; background:var(--c-bg-box); border-radius:4px; }
+.nosweat-review-heading { display:flex; align-items:center; justify-content:space-between; gap:1em; margin-bottom:.7em; }
+.nosweat-review-heading h2 { margin:0; font-size:1.15em; }
+.nosweat-game-review table { width:100%; text-align:center; border-collapse:collapse; margin:.6em 0; }
+.nosweat-game-review th:first-child { text-align:left; }
+.nosweat-game-review th,.nosweat-game-review td { padding:.3em .5em; border-bottom:1px solid var(--c-border); }
+.nosweat-accuracy td { font-size:1.5em; }
+.nosweat-classifications button { min-width:3em; padding:.15em .5em; }
+.nosweat-review-graph { width:100%; max-height:150px; color:var(--c-font); background:var(--c-bg-low); }
+.nosweat-review-graph a:focus circle { stroke:var(--c-primary); stroke-width:3; }
+.nosweat-computed-glyph { font-weight:bold; margin-left:.12em; }
+.nosweat-computed-glyph.brilliant { color:#15aabf; }
+.nosweat-computed-glyph.good { color:#12b886; }
+.nosweat-computed-glyph.interesting { color:#82c91e; }
+.nosweat-computed-glyph.dubious { color:#fab005; }
+.nosweat-computed-glyph.mistake { color:#fd7e14; }
+.nosweat-computed-glyph.blunder { color:#fa5252; }
+
+/* Keep the entry page focused on choosing a time control. */
+.lobby.mutechess-play { width:100%; max-width:64em; margin-inline:auto; grid-template-columns:minmax(0,1fr); grid-template-rows:auto; grid-template-areas:'app' 'about'; }
+.mutechess-play .lobby__table { display:contents; }
+.mutechess-play .lobby__about { margin-top:1.5em; justify-content:center; }
+.nosweat-rating-explorer h3 { margin:.8em 0 .4em; font-size:1.1em; }
+.nosweat-rating-chart svg { width:100%; display:block; overflow:visible; }
+.nosweat-chart-legend { justify-content:flex-end; gap:.5em; }
+.nosweat-chart-legend .fbt { padding:.15em .3em; }
+.nosweat-rating-chart [role=button]:focus-visible { outline:2px solid currentColor; }
+.nosweat-rating-explorer details { margin-top:.5em; }
+.mutechess-info { max-width:52em; margin-inline:auto; line-height:1.7; overflow-wrap:anywhere; }
+.mutechess-info nav { display:flex; flex-wrap:wrap; gap:1em; margin-bottom:1.5em; }
+.mutechess-info h2 { margin-top:1.5em; }
+
+/* Two independent Maia channels; shared full-width rating explorer. */
+.nosweat-candidate-panel { min-width:0; margin-bottom:1em; }
+.nosweat-candidate-panel > h2 { margin:0 0 .65em; font-size:1.1em; }
+.nosweat-maia-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65em; align-items:start; }
+.nosweat-maia-cards:has(> :only-child) { grid-template-columns:1fr; }
+.nosweat-maia-card { min-width:0; background:var(--c-bg-box); border-radius:5px; overflow:hidden; }
+.nosweat-maia-card header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.2em .4em; padding:.65em .6em .35em; }
+.nosweat-maia-label { font-weight:bold; padding:.15em 0; border-radius:3px; text-align:left; font-size:.95em; }
+.nosweat-maia-label:hover { text-decoration:underline; text-underline-offset:.25em; }
+.nosweat-score { display:inline-flex; align-items:center; gap:.3em; font-size:.85em; white-space:nowrap; font-variant-numeric:tabular-nums; }
+.nosweat-score i { width:.65em; height:.65em; flex:0 0 .65em; border-radius:50%; border:1px solid #999; }
+.nosweat-score-side.white { background:#fff; }
+.nosweat-score-side.black { background:#111; }
+.nosweat-policy-scroll { max-height:24em; overflow:auto; }
+.nosweat-policy { width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; }
+.nosweat-policy th { font-size:.75rem; font-weight:normal; color:var(--c-font-dim); padding:.3em .8em; }
+.nosweat-policy th:first-child,.nosweat-policy td:first-child { text-align:left; }
+.nosweat-policy th:last-child,.nosweat-policy td:last-child { text-align:right; }
+.nosweat-policy td { padding:.25em .6em; font-size:.9em; }
+.nosweat-policy button { color:var(--c-font); text-transform:none; padding:.25em 0; }
+.nosweat-others { display:flex; justify-content:space-between; gap:.3em; padding:.65em .75em; font-size:.8em; width:100%; border-top:1px solid var(--c-border); color:var(--c-font-dim); }
+.nosweat-others:hover { background:var(--c-bg-low); }
+.nosweat-maia-empty { padding:1em .6em; color:var(--c-font-dim); font-size:.85em; }
+.nosweat-rating-explorer { background:var(--c-bg-box); padding:.75em; border-radius:5px; margin-top:.75em; }
+.nosweat-rating-explorer h3 { margin:0 0 .6em; font-size:1em; }
+.nosweat-rating-explorer summary { font-size:.85em; margin-top:.6em; }
+.nosweat-return { margin-top:.5em; font-size:.8em; }
+.nosweat-rating-dialog { width:min(24em,90vw); padding:1.5em; }
+.nosweat-rating-dialog h2 { margin:0 0 1em; font-size:1.4em; }
+.nosweat-rating-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.4em; }
+.nosweat-rating-grid button { padding:.65em .3em; border-radius:4px; background:var(--c-bg-low); }
+.nosweat-rating-grid button[aria-pressed=true] { background:var(--c-primary); color:var(--c-primary-over); }
+.nosweat-candidate-panel [role=status],.nosweat-candidate-panel .error { font-size:.8em; margin:.7em .2em; }
+.nosweat-summary table { table-layout:fixed; width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; }
+.nosweat-summary th { width:27%; color:var(--c-font-dim); font-weight:normal; padding:.4em; text-align:right; vertical-align:bottom; }
+.nosweat-summary th:first-child { width:46%; }
+.nosweat-summary-player { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.nosweat-summary-player a { display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; }
+.nosweat-summary td { padding:.2em .4em; text-align:right; }
+.nosweat-summary td:first-child { text-align:left; overflow-wrap:break-word; }
+.nosweat-summary td button { min-width:2em; padding:.15em; }
+.nosweat-summary .accuracy td { border-top:1px solid var(--c-border); padding-top:.7em; font-weight:bold; }
+.nosweat-summary > .button { margin-top:1em; }
+.nosweat-review-settings { margin-top:1.5em; }
+.nosweat-review-quality { display:flex; gap:1em; flex-wrap:wrap; margin:1em 0; }
+.nosweat-review-quality label { display:flex; align-items:center; gap:.4em; }
+
+/* Candidate quality is Stockfish evidence, independent of model probability. */
+.nosweat-policy button[data-quality=good] { color:#74c476; }
+.nosweat-policy button[data-quality=ok] { color:#fed976; }
+.nosweat-policy button[data-quality=blunder] { color:#fc9272; }
+.light .nosweat-policy button[data-quality=good] { color:#238b45; }
+.light .nosweat-policy button[data-quality=ok] { color:#975000; }
+.light .nosweat-policy button[data-quality=blunder] { color:#b02020; }
+.analyse .mchat.mchat-notes-only { min-height:0; height:auto; align-self:start; }
+.analyse .mchat-notes-only .mchat__content { height:8em; min-height:0; }
+.nosweat-profile-key { min-width:0; max-width:100%; flex-basis:100%; font-size:.8em; }
+.nosweat-profile-key > span { display:block; margin:.3em 0; color:var(--c-font-dim); }
+.nosweat-profile-key input { max-width:100%; }
+
+.analyse .game__meta__players .player { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
