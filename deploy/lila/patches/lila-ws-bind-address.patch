diff --git a/security-dependencies.sbt b/security-dependencies.sbt
new file mode 100644
index 0000000..1ac44b3
--- /dev/null
+++ b/security-dependencies.sbt
@@ -0,0 +1,30 @@
+// Security-only alignment of transitive runtime dependencies (#232).
+// Overrides retain the existing dependency graph and native application behavior.
+ThisBuild / dependencyOverrides ++= {
+  val nettyVersion = "4.2.19.Final"
+  val jacksonVersion = "2.18.11"
+  Seq(
+    "netty-buffer",
+    "netty-codec",
+    "netty-codec-base",
+    "netty-codec-compression",
+    "netty-codec-dns",
+    "netty-codec-http",
+    "netty-codec-http2",
+    "netty-common",
+    "netty-handler",
+    "netty-handler-proxy",
+    "netty-resolver",
+    "netty-resolver-dns",
+    "netty-transport",
+    "netty-transport-classes-epoll",
+    "netty-transport-classes-kqueue",
+    "netty-transport-native-epoll",
+    "netty-transport-native-kqueue",
+    "netty-transport-native-unix-common"
+  ).map("io.netty" % _ % nettyVersion) ++
+    Seq("jackson-annotations", "jackson-core", "jackson-databind")
+      .map("com.fasterxml.jackson.core" % _ % jacksonVersion) ++
+    Seq("jackson-datatype-jdk8", "jackson-datatype-jsr310")
+      .map("com.fasterxml.jackson.datatype" % _ % jacksonVersion)
+}
diff --git a/src/test/scala/FriendPayloadTest.scala b/src/test/scala/FriendPayloadTest.scala
new file mode 100644
index 0000000..9178981
--- /dev/null
+++ b/src/test/scala/FriendPayloadTest.scala
@@ -0,0 +1,25 @@
+package lila.ws
+
+import play.api.libs.json.Json
+
+class FriendPayloadTest extends munit.FunSuite:
+
+  private def friend(displayName: Option[String]) = FriendList.UserView(
+    User.Id("n123"),
+    FriendList.UserData(User.Name("n123"), None, None, displayName),
+    SocialGraph.UserMeta.stale.withOnline(true).withPlaying(true)
+  )
+
+  test("friend payloads keep canonical identity while carrying a chosen name"):
+    val user = friend(Some("Dash <&>"))
+    val entered = Json.parse(ipc.ClientIn.following.Enters(user).write)
+    assertEquals((entered \ "d").as[String], "n123")
+    assertEquals((entered \ "displayName").as[String], "Dash <&>")
+    val online = Json.parse(ipc.ClientIn.following.Onlines(List(user)).write)
+    assertEquals((online \ "displayNames" \ "n123").as[String], "Dash <&>")
+    assertEquals((online \ "playing").as[List[String]], List("n123"))
+
+  test("missing and empty chosen names retain canonical fallback"):
+    List(None, Some("")).foreach: name =>
+      val entered = Json.parse(ipc.ClientIn.following.Enters(friend(name)).write)
+      assertEquals((entered \ "displayName").as[String], "n123")
diff --git a/src/test/scala/SriValidationTest.scala b/src/test/scala/SriValidationTest.scala
new file mode 100644
index 0000000..20e15f0
--- /dev/null
+++ b/src/test/scala/SriValidationTest.scala
@@ -0,0 +1,45 @@
+package lila.ws
+
+import java.net.URLEncoder
+import java.nio.charset.StandardCharsets.UTF_8
+
+import com.typesafe.config.ConfigFactory
+
+class SriValidationTest extends munit.FunSuite:
+
+  private def request(sri: Option[String], mobile: Boolean = false) =
+    val query = sri.fold("")(s => "?sri=" + URLEncoder.encode(s, UTF_8))
+    new util.RequestHeader(
+      util.RequestUri("/lobby/socket/v5" + (if mobile then "" else query)),
+      IpAddress("127.0.0.1"),
+      util.RequestHeader.Headers(
+        "https://mutechess.org",
+        if mobile then "Lichess Mobile/test sri:" + sri.getOrElse("") else "test",
+        None,
+        None
+      )
+    )
+
+  test("old Option overload bypassed string validation; explicit reader rejects it"):
+    val payload = "testsocket01 syntheticUser,testsocket02 anotherUser"
+    val header = request(Some(payload))
+    assertEquals(header.uncheckedSri, Some(payload))
+    assert(Sri.from(header.uncheckedSri).nonEmpty)
+    assertEquals(header.uncheckedSri.flatMap(Sri.read), None)
+
+  test("query strings cannot smuggle account bindings through encoded spaces"):
+    List("testsocket01 syntheticUser", "testsocket01 syntheticUser,testsocket02 anotherUser").foreach:
+      payload => assertEquals(request(Some(payload)).uncheckedSri.flatMap(Sri.read), None)
+
+  test("ordinary browser and mobile SRIs remain unchanged; missing stays absent"):
+    List(false, true).foreach: mobile =>
+      val header = request(Some("normalSRI_12"), mobile)
+      assertEquals(header.uncheckedSri.flatMap(Sri.read).map(_.value), Some("normalSRI_12"))
+    assertEquals(request(None).uncheckedSri.flatMap(Sri.read), None)
+
+  test("anonymous secret fallback uses the same validating reader without database access"):
+    given Executor = parasitic
+    val auth = new Auth(null, null, ConfigFactory.parseString("cookie.name=testCookie\noauth.secrets=[]"))
+    assertEquals(auth.anonSecretFromReq(request(Some("normalSRI_12"))), Some("normalSRI_12"))
+    assertEquals(auth.anonSecretFromReq(request(Some("testsocket01 syntheticUser"))), None)
+    assertEquals(auth.anonSecretFromReq(request(None)), None)
